    "@hocuspocus/provider": "2.15.2",
    "@hocuspocus/server": "2.15.2",
    "@synergy/ai": "*",
    "@synergy/compliance": "*",
    "@synergy/config": "*",
    "@synergy/db": "*",
    "@synergy/identity": "*",
    "@synergy/search": "*",
    "@synergy/shell": "*",
    "lucide-react": "^0.475.0",
    "next": "16.3.5",
    "pg": "^8.13.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yjs": "13.6.20"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
