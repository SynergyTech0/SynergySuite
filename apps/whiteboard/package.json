{
  "name": "synergy-whiteboard",
  "version": "0.1.0",
  "private": true,
  "description": "Synergy Whiteboard - an infinite canvas the whole team draws on at once",
  "scripts": {
    "dev": "npm run fonts && next dev -p 3750",
