}

model ExchangeRate {
  id            String   @id @default(cuid())
  fromCurrency  String
  toCurrency    String
  rate          Decimal  @db.Decimal(12, 8)
  effectiveDate DateTime
  source        String // MANUAL, OPENEXCHANGERATES, ECB, etc.
