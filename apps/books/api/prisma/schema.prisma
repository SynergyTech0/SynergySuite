// SynergyBooks Database Schema
// AI-native accounting platform with embedded IRS tax code intelligence

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// PHASE 1: TAX CORPUS MODELS
// ============================================================================

enum SourceType {
  IRC
  TREASURY_REG
  IRS_PUBLICATION
  REVENUE_RULING
  REVENUE_PROCEDURE
  IRS_FORM
  FORM_INSTRUCTION
  TAX_COURT
  STATE_CODE
}

enum CrawlStatus {
  PENDING
  CRAWLING
  COMPLETED
  FAILED
}

enum TaxCorpusDocumentType {
  STATUTE
  REGULATION
  PUBLICATION
  RULING
  PROCEDURE
  FORM
  INSTRUCTION
  COURT_OPINION
}

enum ProcessingStatus {
  RAW
  PARSED
  EXTRACTED
  CLASSIFIED
  VALIDATED
  PUBLISHED
}

enum RuleType {
  INCLUSION
  DEDUCTION
  EXCLUSION
  CREDIT
  TIMING
  LIMITATION
  PENALTY
  SAFE_HARBOR
  ELECTION
  REPORTING
}

enum EntityType {
  INDIVIDUAL
  C_CORPORATION
  S_CORPORATION
  PARTNERSHIP
  LLC_PARTNERSHIP
  LLC_CORPORATION
  LLC_DISREGARDED
  SOLE_PROPRIETOR
  TRUST_SIMPLE
  TRUST_COMPLEX
  TRUST_GRANTOR
  ESTATE
  NONPROFIT_501C3
  NONPROFIT_OTHER
  GOVERNMENT
  SOLE_PROPRIETORSHIP
  LLC
  S_CORP
  C_CORP
  NON_PROFIT
  TRUST
}

enum LimitationType {
  DOLLAR_CAP
  PERCENTAGE_CAP
  AGI_PHASEOUT
  INCOME_LIMIT
  ACTIVITY_LIMIT
  CARRYFORWARD_LIMIT
  CARRYBACK_LIMIT
}

enum ThresholdType {
  FIXED_AMOUNT
  PERCENTAGE_OF_AGI
  PERCENTAGE_OF_INCOME
  PERCENTAGE_OF_BASIS
  FORMULA
}

enum FilingStatus {
  SINGLE
  MARRIED_FILING_JOINTLY
  MARRIED_FILING_SEPARATELY
  HEAD_OF_HOUSEHOLD
  QUALIFYING_WIDOW
}

enum CrossRefType {
  IRC_SECTION
  TREASURY_REG
  PUBLICATION
  RULING
  FORM
  COURT_CASE
}

enum CrossRefRelationship {
  IMPLEMENTS
  EXPLAINS
  EXCEPTS
  MODIFIES
  SUPERSEDES
  CROSS_REFERENCES
  CONFLICTS
}

enum ExtractionType {
  SECTION_BOUNDARY
  HIERARCHY
  DEFINITION
  RULE
  EXCEPTION
  LIMITATION
  CROSS_REFERENCE
  EFFECTIVE_DATE
  AMOUNT_THRESHOLD
}

enum GraphNodeType {
  IRC_SECTION
  TREASURY_REG
  IRS_PUBLICATION
  REVENUE_RULING
  IRS_FORM
  FORM_LINE
  DEFINITION
  RULE
  EXCEPTION
  THRESHOLD
  ENTITY_TYPE
  TRANSACTION_TYPE
  TAX_TREATMENT
}

enum GraphEdgeType {
  IMPLEMENTS
  EXPLAINS
  INTERPRETS
  REQUIRES
  MAPS_TO
  EXCEPTS
  MODIFIES
  SUPERSEDES
  CROSS_REFERENCES
  APPLIES_TO
  HAS_LIMITATION
  HAS_EXCEPTION
  DEFINES
  CONFLICTS_WITH
}

model TaxCorpusSource {
  id           String        @id @default(cuid())
  sourceType   SourceType
  sourceUrl    String
  sourceName   String?
  lastCrawled  DateTime?
  lastModified DateTime?
  contentHash  String?
  status       CrawlStatus   @default(PENDING)
  errorLog     String?       @db.Text
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  documents    TaxDocument[]

  @@index([sourceType])
  @@index([status])
}

model TaxDocument {
  id             String                @id @default(cuid())
  sourceId       String
  source         TaxCorpusSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  documentType   TaxCorpusDocumentType
  identifier     String // e.g., "IRC 162(a)", "Pub 463", "Rev. Rul. 2024-01"
  title          String
  rawContent     String                @db.Text
  parsedContent  Json?
  effectiveDate  DateTime?
  expirationDate DateTime?
  version        Int                   @default(1)
  contentHash    String
  status         ProcessingStatus      @default(RAW)
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  sections       TaxSection[]
  extractions    TaxExtraction[]

  @@unique([sourceId, identifier, version])
  @@index([documentType])
  @@index([status])
  @@index([identifier])
}

model TaxSection {
  id                    String              @id @default(cuid())
  documentId            String
  document              TaxDocument         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sectionNumber         String // e.g., "162", "162(a)", "162(a)(1)"
  sectionTitle          String?
  fullPath              String // e.g., "Title 26 > Subtitle A > Chapter 1 > Subchapter B > Part VI > Section 162"
  parentId              String?
  parent                TaxSection?         @relation("SectionHierarchy", fields: [parentId], references: [id])
  children              TaxSection[]        @relation("SectionHierarchy")
  content               String              @db.Text
  summary               String?             @db.Text
  effectiveDate         DateTime?
  expirationDate        DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  rules                 TaxRule[]
  definitions           TaxDefinition[]
  crossReferences       TaxCrossReference[] @relation("CrossRefSource")
  targetCrossReferences TaxCrossReference[] @relation("CrossRefTarget")
  limitations           TaxLimitation[]
  exceptions            TaxException[]
  extractions           TaxExtraction[]

  @@unique([documentId, sectionNumber])
  @@index([sectionNumber])
}

model TaxRule {
  id           String          @id @default(cuid())
  sectionId    String
  section      TaxSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  ruleType     RuleType
  condition    String          @db.Text
  consequence  String          @db.Text
  category     String?
  summary      String?         @db.Text
  ruleText     String?         @db.Text
  exceptions   TaxException[]
  limitations  TaxLimitation[]
  applicableTo EntityType[]
  confidence   Float
  extractionId String
  extraction   TaxExtraction   @relation(fields: [extractionId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([ruleType])
  @@index([sectionId])
}

model TaxDefinition {
  id         String     @id @default(cuid())
  sectionId  String
  section    TaxSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  term       String
  definition String     @db.Text
  scope      String?
  confidence Float
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([term])
}

model TaxException {
  id             String      @id @default(cuid())
  ruleId         String
  rule           TaxRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  condition      String      @db.Text
  description    String      @db.Text
  confidence     Float
  exceptionType  String?
  effectiveDate  DateTime?
  expirationDate DateTime?
  sectionId      String?
  section        TaxSection? @relation(fields: [sectionId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model TaxLimitation {
  id                  String         @id @default(cuid())
  ruleId              String
  rule                TaxRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  limitationType      LimitationType
  thresholdType       ThresholdType
  thresholdValue      Decimal?       @db.Decimal(19, 4)
  thresholdFormula    String?
  thresholdPercentage Decimal?       @db.Decimal(19, 4)
  description         String?        @db.Text
  phaseoutStart       Decimal?       @db.Decimal(19, 4)
  phaseoutEnd         Decimal?       @db.Decimal(19, 4)
  effectiveDate       DateTime?
  expirationDate      DateTime?
  sectionId           String?
  section             TaxSection?    @relation(fields: [sectionId], references: [id])
  filingStatuses      FilingStatus[]
  taxYearStart        Int?
  taxYearEnd          Int?
  indexedForInflation Boolean        @default(false)
  confidence          Float
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model TaxCrossReference {
  id               String               @id @default(cuid())
  sourceSectionId  String
  sourceSection    TaxSection           @relation("CrossRefSource", fields: [sourceSectionId], references: [id], onDelete: Cascade)
  targetIdentifier String
  targetType       CrossRefType
  relationship     CrossRefRelationship
  referenceType    String?
  targetSectionId  String?
  targetSection    TaxSection?          @relation("CrossRefTarget", fields: [targetSectionId], references: [id])
  context          String?
  confidence       Float
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([targetIdentifier])
}

model TaxExtraction {
  id             String         @id @default(cuid())
  documentId     String
  document       TaxDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sectionId      String?
  section        TaxSection?    @relation(fields: [sectionId], references: [id])
  extractionType ExtractionType
  modelUsed      String
  modelVersion   String
  rawOutput      Json
  confidence     Float
  humanReviewed  Boolean        @default(false)
  humanApproved  Boolean?
  reviewedBy     String?
  reviewedAt     DateTime?
  rules          TaxRule[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([extractionType])
  @@index([documentId])
}

// Knowledge Graph Models
model TaxGraphNode {
  id            String         @id @default(cuid())
  nodeType      GraphNodeType
  identifier    String         @unique
  label         String
  properties    Json
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  outgoingEdges TaxGraphEdge[] @relation("OutgoingEdges")
  incomingEdges TaxGraphEdge[] @relation("IncomingEdges")

  @@index([nodeType])
}

model TaxGraphEdge {
  id         String        @id @default(cuid())
  sourceId   String
  source     TaxGraphNode  @relation("OutgoingEdges", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId   String
  target     TaxGraphNode  @relation("IncomingEdges", fields: [targetId], references: [id], onDelete: Cascade)
  edgeType   GraphEdgeType
  properties Json?
  weight     Float         @default(1.0)
  confidence Float         @default(1.0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([sourceId, targetId, edgeType])
  @@index([edgeType])
}

// ============================================================================
// PHASE 2: CORE ACCOUNTING MODELS
// ============================================================================

enum AccountingMethod {
  CASH
  ACCRUAL
  HYBRID
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum TaxTreatmentType {
  ORDINARY_INCOME
  CAPITAL_GAIN_SHORT
  CAPITAL_GAIN_LONG
  TAX_EXEMPT
  DEDUCTIBLE_FULL
  DEDUCTIBLE_LIMITED
  NON_DEDUCTIBLE
  DEFERRED
  AMORTIZABLE
  DEPRECIABLE
}

enum PeriodType {
  MONTH
  QUARTER
  YEAR
  CUSTOM
}

enum PeriodStatus {
  OPEN
  SOFT_CLOSE
  HARD_CLOSE
  FUTURE
  CLOSED
  LOCKED
}

enum JournalSource {
  MANUAL
  BANK_IMPORT
  INVOICE
  BILL
  PAYROLL
  DEPRECIATION
  ADJUSTMENT
  CLOSING
  SYSTEM
  IMPORT
  PAYMENT
  RECEIPT
  BANK_FEED
  ACCRUAL
  TAX
}

enum JournalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REVERSED
  VOIDED
}

enum ClassificationMethod {
  AI_AUTO
  RULE_BASED
  USER_SPECIFIED
  CPA_REVIEWED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVIEW
}

enum DeductionType {
  ABOVE_THE_LINE
  BELOW_THE_LINE_ITEMIZED
  BELOW_THE_LINE_STANDARD
  BUSINESS_EXPENSE
  CAPITAL_EXPENSE
  NOT_DEDUCTIBLE
}

enum DeductionLimit {
  NONE
  FIFTY_PERCENT
  THIRTY_PERCENT
  AGI_BASED
  DOLLAR_CAP
  HOBBY_LOSS
  PASSIVE_ACTIVITY
  AT_RISK
}

enum AuditRiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum AuthorityType {
  IRC
  TREASURY_REG
  IRS_PUBLICATION
  REVENUE_RULING
  REVENUE_PROCEDURE
  TAX_COURT
  APPEALS_COURT
  SUPREME_COURT
}

model Organization {
  id                   String              @id @default(cuid())
  externalId           String?             @unique // SynergyAuth organization ID
  name                 String
  entityType           EntityType
  taxId                String?
  fiscalYearEnd        Int                 @default(12)
  accountingMethod     AccountingMethod    @default(ACCRUAL)
  industry             String?
  stateOfIncorporation String?
  address              Json?
  settings             Json?
  legalName            String?
  naicsCode            String?
  defaultCurrency      String?             @default("USD")
  subscriptionTier     String?
  isActive             Boolean?            @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  chartOfAccounts      Account[]
  journals             Journal[]
  fiscalPeriods        FiscalPeriod[]
  taxReturns           TaxReturn[]
  users                OrganizationUser[]
  customers            Customer[]
  vendors              Vendor[]
  bankAccounts         BankAccount[]
  taxPositions         TaxPosition[]
  estimates            Estimate[]          @relation("OrganizationEstimates")
  purchaseOrders       PurchaseOrder[]     @relation("OrganizationPOs")
  goodsReceipts        GoodsReceipt[]      @relation("OrganizationReceipts")
  expenses             Expense[]           @relation("OrganizationExpenses")
  inventoryItems       InventoryItem[]     @relation("OrganizationInventory")
  budgets              Budget[]            @relation("OrganizationBudgets")
  employees            Employee[]          @relation("OrganizationEmployees")
  timesheets           Timesheet[]         @relation("OrganizationTimesheets")
  documents            Document[]          @relation("OrganizationDocuments")
  auditTrail           AuditTrailEntry[]   @relation("OrganizationAuditTrail")
  bulkImports          BulkImport[]        @relation("OrganizationImports")
  tasks                Task[]              @relation("OrganizationTasks")
  // New QuickBooks feature relations
  paymentGateways      PaymentGateway[]
  payrollSettings      PayrollSettings?
  salesTaxRates        SalesTaxRate[]
  taxAgencies          TaxAgency[]
  salesTaxLiabilities  SalesTaxLiability[]
  productTaxability    ProductTaxability[]
  fixedAssets          FixedAsset[]
  bankFeedRules        BankFeedRule[]
  form1099s            Form1099[]
  creditMemos          CreditMemo[]
  vendorCredits        VendorCredit[]
  recurringTemplates   RecurringTemplate[]
  classes              Class[]
  locations            Location[]
  projects             Project[]
  customerStatements   CustomerStatement[]
  emailTemplates       EmailTemplate[]
  emailLogs            EmailLog[]
  CheckTemplate        CheckTemplate[]
  CheckPrint           CheckPrint[]
  CheckBatch           CheckBatch[]
  InventoryBundle      InventoryBundle[]
  ACHBatch             ACHBatch[]
  PayrollTaxFiling     PayrollTaxFiling[]
  EFTPSTransaction     EFTPSTransaction[]
  EFTPSEnrollment      EFTPSEnrollment?
  MobileDeposit        MobileDeposit[]
  invoices             Invoice[]           @relation("OrganizationInvoices")
  customerPayments     CustomerPayment[]   @relation("OrganizationCustomerPayments")

  @@index([entityType])
}

model OrganizationUser {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String // SynergyAuth user ID
  role           String       @default("member")
  permissions    String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
}

model Account {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountNumber    String
  name             String
  description      String?
  accountType      AccountType
  accountSubtype   String?
  normalBalance    NormalBalance
  taxCode          String?
  currency         String?            @default("USD")
  isActive         Boolean            @default(true)
  isBankAccount    Boolean            @default(false)
  isSystemAccount  Boolean            @default(false)
  parentId         String?
  parent           Account?           @relation("AccountHierarchy", fields: [parentId], references: [id])
  children         Account[]          @relation("AccountHierarchy")
  taxMapping       AccountTaxMapping?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  journalLines     JournalLine[]
  expenses         Expense[]
  inventoryItems   InventoryItem[]
  budgetLineItems  BudgetLineItem[]   @relation("BudgetLineItems")
  bankAccountsGL   BankAccount[]      @relation("BankAccountGL")
  bankTxCategories BankTransaction[]  @relation("BankTxCategory")

  @@unique([organizationId, accountNumber])
  @@index([accountType])
}

model AccountTaxMapping {
  id                String            @id @default(cuid())
  accountId         String            @unique
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  primaryIrcSection String?
  defaultTreatment  TaxTreatmentType?
  scheduleMapping   String?
  form1099Type      String?
  requiresTracking  Boolean           @default(false)
  trackingType      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model FiscalPeriod {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodType     PeriodType
  periodNumber   Int          @default(0)
  fiscalYear     Int?
  name           String?
  startDate      DateTime
  endDate        DateTime
  status         PeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedBy       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  journals       Journal[]

  @@unique([organizationId, fiscalYear, periodType, periodNumber])
  @@index([fiscalYear])
}

model Journal {
  id                      String                         @id @default(cuid())
  organizationId          String
  organization            Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodId                String?
  period                  FiscalPeriod?                  @relation(fields: [periodId], references: [id])
  journalNumber           String
  journalDate             DateTime
  description             String?
  reference               String?
  sourceType              JournalSource
  sourceId                String?
  status                  JournalStatus                  @default(DRAFT)
  type                    String?
  tags                    String[]
  createdBy               String?
  voidedAt                DateTime?
  voidReason              String?
  voidedBy                String?
  isAdjusting             Boolean                        @default(false)
  isReversing             Boolean                        @default(false)
  reversesJournalId       String?
  reversedByJournalId     String?
  postedAt                DateTime?
  postedBy                String?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  lines                   JournalLine[]
  taxClassifications      TransactionTaxClassification[]
  bills                   Bill[]                         @relation("BillJournal")
  matchedBankTransactions BankTransaction[]              @relation("MatchedBankTransactions")

  @@unique([organizationId, journalNumber])
  @@index([journalDate])
  @@index([status])
}

model JournalLine {
  id                String                        @id @default(cuid())
  journalId         String
  journal           Journal                       @relation(fields: [journalId], references: [id], onDelete: Cascade)
  lineNumber        Int
  accountId         String
  account           Account                       @relation(fields: [accountId], references: [id])
  description       String?
  debit             Decimal                       @default(0) @db.Decimal(19, 4)
  credit            Decimal                       @default(0) @db.Decimal(19, 4)
  memo              String?
  referenceType     String?
  referenceId       String?
  taxCode           String?
  quantity          Decimal?                      @db.Decimal(19, 4)
  unitPrice         Decimal?                      @db.Decimal(19, 4)
  taxClassification JournalLineTaxClassification?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  // Class/Location tracking
  classId    String?
  class      Class?    @relation(name: "JournalLineClass", fields: [classId], references: [id], onDelete: SetNull)
  locationId String?
  location   Location? @relation(name: "JournalLineLocation", fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([journalId, lineNumber])
}

model TransactionTaxClassification {
  id                   String                         @id @default(cuid())
  journalId            String
  journal              Journal                        @relation(fields: [journalId], references: [id], onDelete: Cascade)
  classificationMethod ClassificationMethod
  overallConfidence    Float
  reviewStatus         ReviewStatus                   @default(PENDING)
  reviewedBy           String?
  reviewedAt           DateTime?
  reviewNotes          String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  lineClassifications  JournalLineTaxClassification[]
}

model JournalLineTaxClassification {
  id                          String                        @id @default(cuid())
  journalLineId               String                        @unique
  journalLine                 JournalLine                   @relation(fields: [journalLineId], references: [id], onDelete: Cascade)
  transactionClassificationId String?
  transactionClassification   TransactionTaxClassification? @relation(fields: [transactionClassificationId], references: [id], onDelete: Cascade)
  taxTreatment                TaxTreatmentType?
  ircSection                  String?
  regulationRef               String?
  deductionType               DeductionType?
  deductionLimit              DeductionLimit?
  limitedAmount               Decimal?                      @db.Decimal(19, 4)
  disallowedAmount            Decimal?                      @db.Decimal(19, 4)
  carryforwardAmount          Decimal?                      @db.Decimal(19, 4)
  recognitionYear             Int?
  isDeferral                  Boolean                       @default(false)
  deferralEndYear             Int?
  requiredDocs                String[]
  hasRequiredDocs             Boolean                       @default(false)
  confidence                  Float
  auditRiskLevel              AuditRiskLevel                @default(LOW)
  auditRiskFactors            String[]
  category                    String?
  classifiedAt                DateTime?
  deductibility               String?
  deductiblePercentage        Float?
  explanation                 String?                       @db.Text
  formPlacement               Json?
  isManualOverride            Boolean?                      @default(false)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  citations                   TaxCitation[]

  @@index([ircSection])
  @@index([taxTreatment])
}

model TaxCitation {
  id                             String                        @id @default(cuid())
  classificationId               String?
  classification                 JournalLineTaxClassification? @relation(fields: [classificationId], references: [id], onDelete: Cascade)
  journalLineTaxClassificationId String?
  authorityType                  AuthorityType?
  authorityId                    String?
  section                        String?
  regulation                     String?
  publication                    String?
  courtCase                      String?
  citationText                   String?                       @db.Text
  relevanceScore                 Float
  createdAt                      DateTime                      @default(now())
}

// ============================================================================
// PHASE 3: FINANCIAL MODULES
// ============================================================================

// Accounts Receivable
enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIAL
  PAID
  OVERDUE
  VOID
  WRITTEN_OFF
  APPROVED
}

model Customer {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalId      String?
  name            String
  email           String?
  phone           String?
  billingAddress  Json?
  shippingAddress Json?
  taxExempt       Boolean           @default(false)
  taxExemptNumber String?
  creditLimit     Decimal?          @db.Decimal(19, 4)
  paymentTerms    Int?
  company         String?
  taxId           String?
  balance         Decimal?          @db.Decimal(19, 4)
  isActive        Boolean?          @default(true)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  invoices        Invoice[]
  payments        CustomerPayment[]
  estimates       Estimate[]

  // New QuickBooks feature relations
  paymentMethods      PaymentMethod[]
  paymentTransactions PaymentTransaction[]
  creditMemos         CreditMemo[]
  statements          CustomerStatement[]
  portalAccess        CustomerPortalAccess?
  projects            Project[]
  bankTransactions    BankTransaction[]     @relation("CustomerBankTransactions")

  @@unique([organizationId, externalId])
  @@index([name])
}

model Invoice {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation("OrganizationInvoices", fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer          @relation(fields: [customerId], references: [id])
  projectId      String?
  project        Project?          @relation("ProjectInvoices", fields: [projectId], references: [id])
  invoiceNumber  String
  invoiceDate    DateTime
  dueDate        DateTime
  status         InvoiceStatus     @default(DRAFT)
  subtotal       Decimal           @db.Decimal(19, 4)
  taxAmount      Decimal           @default(0) @db.Decimal(19, 4)
  totalAmount    Decimal           @db.Decimal(19, 4)
  amountPaid     Decimal           @default(0) @db.Decimal(19, 4)
  amountDue      Decimal           @db.Decimal(19, 4)
  discountAmount Decimal?          @db.Decimal(19, 4)
  poNumber       String?
  memo           String?
  sentAt         DateTime?
  paidAt         DateTime?
