// Banking & Reconciliation
enum BankAccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  MONEY_MARKET
  LINE_OF_CREDIT
}

enum BankTransactionType {
  DEBIT
  CREDIT
  DEPOSIT
  ADJUSTMENT
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  CREATED
  EXCLUDED
  RECONCILED
  PENDING
  CLEARED
}

enum MatchMethod {
  EXACT_MATCH
  FUZZY_MATCH
  AI_SUGGESTED
  MANUAL
  RULE_BASED
}

enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
  DISCREPANCY
  ABANDONED
}

model BankAccount {
  id               String               @id @default(cuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId        String // Link to GL account
  glAccount        Account              @relation("BankAccountGL", fields: [accountId], references: [id])
  bankName         String
  accountName      String
  accountNumber    String // Last 4 digits for display
  routingNumber    String?
  accountType      BankAccountType
  currency         String               @default("USD")
  currentBalance   Decimal              @db.Decimal(19, 4)
  availableBalance Decimal?             @db.Decimal(19, 4)
  plaidItemId      String?
  plaidAccessToken String? // Encrypted
  lastSyncAt       DateTime?
  isActive         Boolean              @default(true)
  isPrimary        Boolean?             @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  transactions     BankTransaction[]
  reconciliations  BankReconciliation[]

  // New QuickBooks feature relations
  feedConnections  BankFeedConnection[]
  achBatches       ACHBatch[]           @relation("ACHBatchBankAccount")
  eftpsEnrollments EFTPSEnrollment[]    @relation("EFTPSEnrollmentBank")
  checkTemplates   CheckTemplate[]      @relation("CheckTemplateBank")
  mobileDeposits   MobileDeposit[]      @relation("MobileDepositBank")
}

model BankTransaction {
  id                        String                @id @default(cuid())
  bankAccountId             String
  bankAccount               BankAccount           @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  externalId                String?
  transactionDate           DateTime
  postDate                  DateTime?
  description               String?
  originalDescription       String?
  amount                    Decimal               @db.Decimal(19, 4)
  transactionType           BankTransactionType
  category                  String?
  merchantName              String?
  pending                   Boolean               @default(false)
  status                    BankTransactionStatus @default(UNMATCHED)
  reference                 String?
  referenceNumber           String?
  categoryAccountId         String?
  categoryAccount           Account?              @relation("BankTxCategory", fields: [categoryAccountId], references: [id])
  vendorId                  String?
  vendor                    Vendor?               @relation("VendorBankTransactions", fields: [vendorId], references: [id])
  customerId                String?
  customer                  Customer?             @relation("CustomerBankTransactions", fields: [customerId], references: [id])
  matchedJournalId          String?
  matchedJournal            Journal?              @relation("MatchedBankTransactions", fields: [matchedJournalId], references: [id])
  matchConfidence           Float?
  matchMethod               MatchMethod?
  excludeFromReconciliation Boolean               @default(false)
  metadata                  Json?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@index([transactionDate])
  @@index([status])
}

model BankReconciliation {
  id                String               @id @default(cuid())
  bankAccountId     String
  bankAccount       BankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  periodEnd         DateTime
  statementBalance  Decimal              @db.Decimal(19, 4)
  glBalance         Decimal?             @db.Decimal(19, 4)
  reconciledBalance Decimal?             @db.Decimal(19, 4)
  beginningBalance  Decimal              @default(0) @db.Decimal(19, 4)
  clearedBalance    Decimal              @default(0) @db.Decimal(19, 4)
  difference        Decimal              @db.Decimal(19, 4)
  status            ReconciliationStatus @default(IN_PROGRESS)
  completedAt       DateTime?
  completedBy       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

