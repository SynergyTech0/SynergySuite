// ============================================================================
// PHASE 8F: TIMESHEET & LABOR TRACKING
// ============================================================================

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model Employee {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(name: "OrganizationEmployees", fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  hireDate       DateTime
  department     String?
  jobTitle       String?
  hourlyRate     Decimal?     @db.Decimal(12, 4)
  salary         Decimal?     @db.Decimal(19, 4)
  taxId          String? // SSN or Tax ID
  address        Json?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  timesheets     Timesheet[]
  tasks          Task[]

  // New QuickBooks feature relations
  paychecks           Paycheck[]
  w2Forms             W2Form[]
  deductionSetups     EmployeeDeductionSetup[]
  projectTimeEntries  ProjectTimeEntry[]
  EmployeeBankAccount EmployeeBankAccount[]

  @@unique([organizationId, employeeId])
  @@index([email])
}

model Timesheet {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(name: "OrganizationTimesheets", fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  weekStartDate  DateTime
  weekEndDate    DateTime
  status         TimesheetStatus   @default(DRAFT)
  totalHours     Decimal           @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal           @default(0) @db.Decimal(19, 4)
  hours          Decimal?          @db.Decimal(10, 2)
  hourlyRate     Decimal?          @db.Decimal(12, 4)
  projectId      String?
  project        Project?          @relation("TimesheetProject", fields: [projectId], references: [id], onDelete: SetNull)
  notes          String?
  submittedAt    DateTime?
  submittedBy    String?
  approvedAt     DateTime?
  approvedBy     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  entries        TimesheetEntry[]
  auditTrail     AuditTrailEntry[] @relation("TimesheetAudit")

  @@unique([employeeId, weekStartDate])
  @@index([status])
}

model TimesheetEntry {
  id          String    @id @default(cuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date        DateTime
  hours       Decimal   @db.Decimal(10, 2)
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?  @relation(name: "TimesheetEntryProject", fields: [projectId], references: [id], onDelete: SetNull)
  description String?
  notes       String?
  billable    Boolean   @default(false)
  billingRate Decimal?  @db.Decimal(12, 4)
  invoiced    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id             String           @id @default(cuid())
  organizationId String?
  organization   Organization?    @relation(name: "OrganizationTasks", fields: [organizationId], references: [id], onDelete: Cascade)
  taskName       String?
  name           String?
  description    String?
  employeeId     String?
  employee       Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignedTo     String?
  priority       String?
  estimatedHours Decimal?         @db.Decimal(10, 2)
  actualHours    Decimal?         @db.Decimal(10, 2)
  dueDate        DateTime?
  completedAt    DateTime?
  projectId      String?
  project        Project?         @relation("TaskProject", fields: [projectId], references: [id], onDelete: SetNull)
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  entries        TimesheetEntry[]
}

// ============================================================================
// PHASE 8G: DOCUMENT STORAGE & AUDIT TRAIL
// ============================================================================

enum StorageDocumentType {
  INVOICE
  BILL
  PO
  ESTIMATE
  RECEIPT
  EXPENSE_RECEIPT
  CONTRACT
  TAX_FORM
  STATEMENT
  OTHER
}

model Document {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(name: "OrganizationDocuments", fields: [organizationId], references: [id], onDelete: Cascade)
  documentType      StorageDocumentType
  fileName          String
  fileSize          Int // in bytes
  mimeType          String
  storagePath       String // S3 path or MinIO path
  uploadedBy        String
  uploadedAt        DateTime            @default(now())
  description       String?
  relatedEntityId   String? // ID of related entity
  relatedEntityType String? // Invoice, Bill, PO, Estimate, Expense
  metadata          Json?
  isArchived        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations for specific document types
  invoices  Invoice[]       @relation("InvoiceDocuments")
  bills     Bill[]          @relation("BillDocuments")
  estimates Estimate[]      @relation("EstimateDocuments")
  pos       PurchaseOrder[] @relation("PODocuments")
  receipts  GoodsReceipt[]  @relation("ReceiptDocuments")
  expenses  Expense[]       @relation("ExpenseDocuments")

  @@index([organizationId])
  @@index([relatedEntityType, relatedEntityId])
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUBMIT
  POST
  VOID
  CONVERT
  IMPORT
  EXPORT
}

model AuditTrailEntry {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(name: "OrganizationAuditTrail", fields: [organizationId], references: [id], onDelete: Cascade)
  actionType     AuditActionType
  entityType     String // Transaction, Journal, Invoice, Bill, etc.
  entityId       String
  userId         String
  userEmail      String?
  changes        Json? // Before/after values
  ipAddress      String?
  notes          String?
  createdAt      DateTime        @default(now())

  // Relations for specific entity types
  expenses   Expense[]   @relation("ExpenseAudit")
  timesheets Timesheet[] @relation("TimesheetAudit")

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([actionType])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================================
// PHASE 8H: BULK IMPORT
// ============================================================================

enum ImportStatus {
  PENDING
  VALIDATING
  PROCESSING
  COMPLETED
  FAILED
  ROLLED_BACK
}

model BulkImport {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(name: "OrganizationImports", fields: [organizationId], references: [id], onDelete: Cascade)
  importType     String // TRANSACTIONS, CUSTOMERS, VENDORS, INVOICES, etc.
  fileName       String
  rowCount       Int
  successCount   Int             @default(0)
  errorCount     Int             @default(0)
  status         ImportStatus    @default(PENDING)
  errors         Json? // Array of row errors
  mappingConfig  Json? // Column mapping
  importedBy     String
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  rows           BulkImportRow[]

  @@index([status])
}

model BulkImportRow {
  id              String     @id @default(cuid())
  importId        String
  bulkImport      BulkImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber       Int
  status          String // PENDING, SUCCESS, ERROR
  data            Json
  errors          Json? // Validation errors
  createdEntityId String? // ID of created entity
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([importId, rowNumber])
}

