diff --git a/apps/photocraft-web/src/host.rs b/apps/photocraft-web/src/host.rs
new file mode 100644
index 0000000..ae1727b
--- /dev/null
+++ b/apps/photocraft-web/src/host.rs
@@ -0,0 +1,81 @@
+//! Host bridge: lets a same-origin page that embeds PhotoCraft in an iframe hand it files and
+//! receive what the user saves, in place of the browser's file picker and downloads.
+//!
+//! Off unless the page is opened with `?host` inside a parent frame. Messages are only accepted
+//! from, and only sent to, the page's own origin.
+//!
+//! Parent → app: `{type: "photocraft:open", name: string, bytes: ArrayBuffer}` opens a document.
+//! App → parent: `{type: "photocraft:ready"}` once the app runs, and
+//! `{type: "photocraft:save", name: string, bytes: ArrayBuffer}` for each save or export.
+
+use js_sys::{Object, Reflect, Uint8Array};
+use wasm_bindgen::closure::Closure;
+use wasm_bindgen::{JsCast as _, JsValue};
+
+use crate::web::Inbox;
+
+/// The parent frame, when the page was opened with `?host` and is embedded.
+fn parent() -> Option<web_sys::Window> {
+    let window = web_sys::window()?;
+    let search = window.location().search().ok()?;
+    if !search.trim_start_matches('?').split('&').any(|p| p == "host" || p.starts_with("host=")) {
+        return None;
+    }
+    let parent = window.parent().ok().flatten()?;
+    (!Object::is(&parent, &window)).then_some(parent)
+}
+
+pub fn enabled() -> bool {
+    parent().is_some()
+}
+
+fn origin() -> Option<String> {
+    web_sys::window()?.location().origin().ok()
+}
+
+fn message(kind: &str) -> Object {
+    let msg = Object::new();
+    let _ = Reflect::set(&msg, &"type".into(), &kind.into());
+    msg
+}
+
+/// Delivers files the parent sends into `inbox` (they open like dropped files), then tells the
+/// parent the app is ready.
+pub fn listen(inbox: Inbox, ctx: egui::Context) {
+    let (Some(window), Some(parent), Some(origin)) = (web_sys::window(), parent(), origin()) else { return };
+    let own = origin.clone();
+    let cb = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |e: web_sys::MessageEvent| {
+        if e.origin() != own {
+            return;
+        }
+        let data = e.data();
+        let field = |k: &str| Reflect::get(&data, &JsValue::from_str(k)).ok();
+        if field("type").and_then(|v| v.as_string()).as_deref() != Some("photocraft:open") {
+            return;
+        }
+        let Some(bytes) = field("bytes").filter(|b| b.is_instance_of::<js_sys::ArrayBuffer>()) else {
+            log::error!("host: open message without an ArrayBuffer");
+            return;
+        };
+        let name = field("name").and_then(|v| v.as_string()).unwrap_or_else(|| "image".into());
+        inbox.lock().unwrap_or_else(|e| e.into_inner()).push((name, Uint8Array::new(&bytes).to_vec()));
+        ctx.request_repaint();
+    });
+    if window.add_event_listener_with_callback("message", cb.as_ref().unchecked_ref()).is_ok() {
+        cb.forget();
+    }
+    if let Err(e) = parent.post_message(&message("photocraft:ready"), &origin) {
+        log::error!("host: couldn't signal ready: {e:?}");
+    }
+}
+
+/// Sends a saved or exported file to the parent, named after the last component of `path`.
+pub fn save(path: &str, bytes: &[u8]) -> Result<(), String> {
+    let parent = parent().ok_or("not embedded in a host page")?;
+    let origin = origin().ok_or("no origin")?;
+    let name = std::path::Path::new(path).file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_else(|| "photocraft".into());
+    let msg = message("photocraft:save");
+    let _ = Reflect::set(&msg, &"name".into(), &name.into());
+    let _ = Reflect::set(&msg, &"bytes".into(), &Uint8Array::from(bytes).buffer());
+    parent.post_message(&msg, &origin).map_err(|e| format!("{e:?}"))
+}
