diff --git a/crates/ui-egui/src/brand.rs b/crates/ui-egui/src/brand.rs
new file mode 100644
index 0000000..43353d5
--- /dev/null
+++ b/crates/ui-egui/src/brand.rs
@@ -0,0 +1,21 @@
+//! The name the app shows: Synergy CAD, the suite's CAD app that embeds this editor
+//! (engine/cadcraft-brand.patch in Synergy). The About dialog still credits CADCraft and its licence.
+
+use std::{cell::RefCell, collections::HashMap};
+
+pub const UPSTREAM: &str = "CADCraft";
+pub const NAME: &str = "Synergy CAD";
+
+pub fn rebranded() -> bool {
+    NAME != UPSTREAM
+}
+
+/// `text` with CADCraft replaced by the brand name. Each distinct text is rewritten once and kept,
+/// so labels drawn every frame don't allocate.
+pub fn branded(text: &str) -> &str {
+    if !rebranded() || !text.contains(UPSTREAM) {
+        return text;
+    }
+    thread_local!(static CACHE: RefCell<HashMap<String, &'static str>> = RefCell::new(HashMap::new()));
+    CACHE.with(|c| *c.borrow_mut().entry(text.to_owned()).or_insert_with(|| Box::leak(text.replace(UPSTREAM, NAME).into_boxed_str())))
+}
