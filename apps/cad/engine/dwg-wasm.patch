diff --git a/crates/dwg/Cargo.toml b/crates/dwg/Cargo.toml
index 398df0a..b2cb34b 100644
--- a/crates/dwg/Cargo.toml
+++ b/crates/dwg/Cargo.toml
@@ -8,6 +8,15 @@ license.workspace = true
 [lints]
 workspace = true
 
+[features]
+# DWG on wasm32. Off for the web app itself: wasm32 panics abort, so the reader's catch_unwind
+# guards don't hold there. A host runs it in its own instance (a Web Worker) and restarts that
+# instance when a damaged file traps it.
+wasm = ["dep:acadrust"]
+
 [target.'cfg(not(target_arch = "wasm32"))'.dependencies]
 # MPL-2.0: used as an unmodified dependency only (see plan/adr/0001 and NOTICE).
 acadrust = "0.6.4"
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+acadrust = { version = "0.6.4", optional = true }
