+0\nSECTION\n2\nBLOCKS\n0\nBLOCK\n5\nA1\n330\nA0\n8\n0\n2\n_ArchTick\n70\n0\n10\n0\n20\n0\n30\n0\n0\nLINE\n5\nA2\n330\nA0\n8\n0\n10\n-0.5\n20\n-0.5\n30\n0\n11\n0.5\n21\n0.5\n31\n0\n0\nENDBLK\n5\nA3\n330\nA0\n8\n0\n0\nENDSEC\n\
+0\nSECTION\n2\nENTITIES\n0\nLEADER\n5\nB0\n8\n0\n100\nAcDbEntity\n100\nAcDbLeader\n3\nStandard\n71\n1\n72\n0\n76\n2\n10\n0\n20\n0\n30\n0\n10\n10\n20\n10\n30\n0\n1001\nACAD\n1000\nDSTYLE\n1002\n{\n1070\n341\n1005\nA0\n1002\n}\n0\nENDSEC\n0\nEOF\n";
+    let d = read_dxf(s.as_bytes()).expect("read");
+    let out = write_dxf(&d);
+    let t: Vec<&str> = out.lines().map(str::trim).collect();
+    let pair = |i: usize| (t[i], t[i + 1]);
+    // The written _ArchTick block record and the handle the leader's override names.
+    let rec = (0..t.len() - 1).step_by(2).find(|&i| pair(i) == ("0", "BLOCK_RECORD") && {
+        let end = (i + 2..t.len() - 1).step_by(2).find(|&k| t[k] == "0").unwrap_or(t.len());
+        (i..end).step_by(2).any(|k| pair(k) == ("2", "_ArchTick") || pair(k) == ("2", "_ARCHTICK"))
+    });
+    let rec = rec.expect("arrowhead block record written");
+    let rec_handle = (rec..t.len() - 1).step_by(2).find(|&k| t[k] == "5").map(|k| t[k + 1]).expect("handle");
+    let ldr = (0..t.len() - 1).step_by(2).find(|&i| pair(i) == ("0", "LEADER")).expect("leader");
+    let named = (ldr..t.len() - 1).step_by(2).find(|&k| t[k] == "1005").map(|k| t[k + 1]).expect("override kept");
+    assert_eq!(named, rec_handle, "the override still names the arrowhead block");
+}
