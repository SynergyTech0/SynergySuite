+/// The M×N vertices of a polygon mesh whose faces (in index order) are still exactly its grid
+/// cells; `None` once any is missing or moved (it is then written as a polyface mesh).
+fn mesh_grid(faces: &[&Face3d], (m, n, closed): (u32, u32, u8)) -> Option<(u32, u32, u8, Vec<Vec3>)> {
+    let (mu, nu) = (usize::try_from(m).ok()?, usize::try_from(n).ok()?);
+    if mu < 2 || nu < 2 || mu.checked_mul(nu)? > 1 << 16 {
+        return None;
+    }
+    let rows = if closed & 1 != 0 { mu } else { mu - 1 };
+    let cols = if closed & 32 != 0 { nu } else { nu - 1 };
+    if faces.len() != rows * cols {
+        return None;
+    }
+    let mut v: Vec<Option<Vec3>> = vec![None; mu * nu];
+    let mut put = |i: usize, j: usize, p: Vec3| -> bool {
+        let slot = &mut v[(i % mu) * nu + j % nu];
+        match slot {
+            Some(q) => *q == p,
+            None => {
+                *slot = Some(p);
+                true
+            }
+        }
+    };
+    for i in 0..rows {
+        for j in 0..cols {
+            let c = faces[i * cols + j].corners;
+            if !(put(i, j, c[0]) && put(i, j + 1, c[1]) && put(i + 1, j + 1, c[2]) && put(i + 1, j, c[3])) {
+                return None;
+            }
+        }
+    }
+    let verts: Option<Vec<Vec3>> = v.into_iter().collect();
+    Some((m, n, closed, verts?))
+}
