diff --git a/packages/web/src/host.ts b/packages/web/src/host.ts
new file mode 100644
index 0000000..767d08a
--- /dev/null
+++ b/packages/web/src/host.ts
@@ -0,0 +1,189 @@
+// Part of the Chili3d Project, under the AGPL-3.0 License.
+// See LICENSE file in the project root for full license information.
+
+import {
+    GeometryNode,
+    type IApplication,
+    type INode,
+    Logger,
+    MeshNode,
+    NodeUtils,
+    setDownloadHandler,
+    Transaction,
+} from "@chili3d/core";
+
+/**
+ * The `postMessage` bridge to a same-origin parent page (`?host=parent`), for pages that embed
+ * Chili3D in an `<iframe>` and keep files themselves. Messages are plain objects with a `type`:
+ *
+ * - `chili3d:ready` (to the parent): `{ version }`, the app is listening; send a file now.
+ * - `chili3d:open` (from the parent): `{ name, bytes, document? }`, bytes an `ArrayBuffer` or
+ *   `Uint8Array`. A `.cd` file opens as a document; anything else (STEP, IGES, BREP, STL) is
+ *   imported into a new document named `document` (default: the file name without extension).
+ *   With no message, the parent can send `chili3d:new` `{ document }` for an empty document.
+ * - `chili3d:save` (to the parent): `{ name, bytes }` (a transferred `ArrayBuffer`) for every file
+ *   Chili3D would otherwise download: Save, Save to file and exports.
+ * - `chili3d:failed` (to the parent): `{ error }` when a file couldn't be opened.
+ * - `chili3d:ai` (from the parent): `{ enabled: true, protocol, model, baseURL }` points the AI
+ *   assistant at the parent's model relay (`protocol` "anthropic" or "openai"; `baseURL` on the
+ *   page's own origin, which holds the key), `{ enabled: false }` turns it off. Until the parent
+ *   says, it is off; the assistant never asks for a key of its own.
+ * - `chili3d:geometry` (from the parent): `{ id }`, asks for the model as triangles, answered with
+ *   `chili3d:geometry` `{ id, document, parts }`. Each part is one visible body in world
+ *   coordinates: `position` (xyz per vertex), `index` (three vertices per triangle), `face` (the
+ *   B-rep face each triangle belongs to) and `edges` (xyz pairs, for bodies with no faces, such as
+ *   sketches and wires). The parent draws 2D views from these.
+ *
+ * Only the parent window on the page's own origin is heard or answered.
+ */
+export function startHostBridge(app: IApplication, version: string): boolean {
+    const parent = window.parent;
+    if (!parent || parent === window) return false;
+    const origin = window.location.origin;
+    const send = (message: object, transfer: Transferable[] = []) =>
+        parent.postMessage(message, origin, transfer);
+
+    // Loaded lazily, like the rest of the app, so the bridge doesn't pull the AI clients into the
+    // first bundle. Calls run in order, so the parent's settings land after this default.
+    const ai = import("@chili3d/ai");
+    const setAssistant = (config: Parameters<typeof import("@chili3d/ai").setManagedConfig>[0]) =>
+        ai.then(
+            (m) => m.setManagedConfig(config),
+            (err) => Logger.error(err),
+        );
+    setAssistant(null);
+    setDownloadHandler((blob, name) => {
+        blob.arrayBuffer().then(
+            (bytes) => send({ type: "chili3d:save", name, bytes }, [bytes]),
+            (err) => Logger.error(err),
+        );
+    });
+
+    window.addEventListener("message", (event: MessageEvent) => {
+        if (event.origin !== origin || event.source !== parent) return;
+        const data = event.data as HostMessage | null;
+        if (!data || typeof data !== "object") return;
+        if (data.type === "chili3d:open" && typeof data.name === "string") {
+            const bytes =
+                data.bytes instanceof ArrayBuffer || data.bytes instanceof Uint8Array
+                    ? data.bytes
+                    : undefined;
+            if (!bytes) return;
+            const docName =
+                typeof data.document === "string" && data.document ? data.document : baseName(data.name);
+            open(app, data.name, docName, bytes).catch((err) => {
+                Logger.error(err);
+                send({ type: "chili3d:failed", error: err instanceof Error ? err.message : String(err) });
+            });
+        } else if (data.type === "chili3d:ai") {
+            setAssistant(assistantConfig(data, origin));
+        } else if (data.type === "chili3d:geometry") {
+            const parts = geometry(app);
+            const transfer = parts.flatMap((p) => [
+                p.position.buffer,
+                p.index.buffer,
+                p.face.buffer,
+                p.edges.buffer,
+            ]);
+            send(
+                {
+                    type: "chili3d:geometry",
+                    id: data.id,
+                    document: app.activeView?.document?.name ?? "",
+                    parts,
+                },
+                transfer,
+            );
+        } else if (data.type === "chili3d:new") {
+            const docName = typeof data.document === "string" && data.document ? data.document : "Untitled";
+            app.newDocument(docName).catch((err) => Logger.error(err));
+        }
+    });
+
+    send({ type: "chili3d:ready", version });
+    return true;
+}
+
+type HostMessage = {
+    type?: unknown;
+    name?: unknown;
+    bytes?: unknown;
+    document?: unknown;
+    id?: unknown;
+    enabled?: unknown;
+    protocol?: unknown;
+    model?: unknown;
+    baseURL?: unknown;
+};
+
+/** The assistant's model settings from a `chili3d:ai` message; off unless it names a same-origin relay. */
+function assistantConfig(data: HostMessage, origin: string) {
+    if (data.enabled !== true || typeof data.model !== "string" || typeof data.baseURL !== "string")
+        return null;
+    const provider =
+        data.protocol === "anthropic" ? "anthropic" : data.protocol === "openai" ? "completions" : null;
+    const url = new URL(data.baseURL, origin);
+    if (!provider || url.origin !== origin) return null;
+    // The relay adds the real key; the provider clients only need a non-empty one.
+    return { provider, baseURL: url.href, model: data.model, apiKey: "suite" } as const;
+}
+
+function baseName(name: string) {
+    return name.replace(/\.[^.]+$/, "") || "Untitled";
+}
+
+async function open(app: IApplication, name: string, docName: string, bytes: ArrayBuffer | Uint8Array) {
+    if (name.toLowerCase().endsWith(".cd")) {
+        const json = JSON.parse(new TextDecoder().decode(bytes));
+        const document = await app.loadDocument(json);
+        if (document) document.name = docName;
+    } else {
+        // Import into a fresh document so the model's name, and so its saves, follow the file.
+        const document = await app.newDocument(docName);
+        const file = new File([bytes as BlobPart], name);
+        await Transaction.executeAsync(document, "import model", async () => {
+            await app.dataExchange.import(document, [file]);
+        });
+    }
+    app.activeView?.cameraController.fitContent();
+}
+
+type Part = { position: Float32Array; index: Uint32Array; face: Uint32Array; edges: Float32Array };
+
+const shown = (node: INode) => node.visible && node.parentVisible;
+
+/** Every visible body of the active document, as world-space triangles and edges. */
+function geometry(app: IApplication): Part[] {
+    const document = app.activeView?.document;
+    if (!document) return [];
+    const parts: Part[] = [];
+    for (const node of NodeUtils.findNodes(document.modelManager.rootNode, shown)) {
+        if (node instanceof GeometryNode) {
+            const mesh = node.mesh;
+            const world = node.worldTransform();
+            const faces = mesh.faces;
+            const face = new Uint32Array((faces?.index.length ?? 0) / 3);
+            faces?.range.forEach((range, i) => {
+                face.fill(i, range.start / 3, (range.start + range.count) / 3);
+            });
+            parts.push({
+                position: new Float32Array(faces ? world.ofPoints(faces.position) : []),
+                index: new Uint32Array(faces?.index ?? []),
+                face,
+                edges: new Float32Array(
+                    !faces?.index.length && mesh.edges ? world.ofPoints(mesh.edges.position) : [],
+                ),
+            });
+        } else if (node instanceof MeshNode && node.mesh.meshType === "surface" && node.mesh.index) {
+            // A plain triangle mesh: each triangle is its own face.
+            const index = new Uint32Array(node.mesh.index);
+            parts.push({
+                position: new Float32Array(node.worldTransform().ofPoints(node.mesh.position ?? [])),
+                index,
+                face: Uint32Array.from({ length: index.length / 3 }, (_, i) => i),
+                edges: new Float32Array(),
+            });
+        }
+    }
+    return parts;
+}
