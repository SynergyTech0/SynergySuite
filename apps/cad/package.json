{
  "name": "synergy-cad",
  "version": "0.1.0",
  "private": true,
  "description": "Synergy CAD: 2D drafting with DWG and DXF drawings (CADCraft) and 3D modeling (Chili3D) in the suite, both WebAssembly, with an AI modeling assistant on the suite's own model.",
