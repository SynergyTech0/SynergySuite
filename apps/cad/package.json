    "engine:3d": "sh engine/build-3d.sh"
  },
  "dependencies": {
    "@synergy/ai": "*",
    "@synergy/identity": "*",
    "@synergy/shell": "*",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
