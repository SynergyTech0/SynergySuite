{
  "name": "synergy-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Synergy Flow - automated workflows across the suite and outside services, built on the Activepieces engine",
  "scripts": {
    "dev": "next dev -p 3780",
    "build": "npm run build:piece && next build",
    "build:piece": "node piece/build.mjs",
    "start": "next start -H 0.0.0.0 -p 3780",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@synergy/config": "*",
    "@synergy/identity": "*",
    "@synergy/search": "*",
    "@synergy/shell": "*",
    "lucide-react": "^0.475.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@activepieces/pieces-common": "0.12.5",
    "@activepieces/pieces-framework": "0.32.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
