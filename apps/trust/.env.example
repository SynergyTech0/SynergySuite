# Trust, for local development. Copy to .env.local (never commit it). In the suite's
# Docker deployment these come from deploy/.env instead (see deploy/compose.yml).

# Postgres. The connecting role owns the schema; requests run as strust_app / strust_app_ro,
# which the migrations create.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trust

# Without the suite gateway in front, sign in as this user (ignored when NODE_ENV=production).
DEV_USER_EMAIL=you@example.com

# Name of the organisation created for the first user. Default: My Company.
TRUST_COMPANY_NAME=

# Set by the suite: makes the launcher link to https://<app>.SUITE_DOMAIN, and (with
# PROXY_SHARED_SECRET) refuses requests that did not come through the gateway.
SUITE_DOMAIN=
PROXY_SHARED_SECRET=

# Optional: hosts for scripts/seed-monitors.mjs (comma-separated). See README.
TRUST_MONITOR_HOSTS=
