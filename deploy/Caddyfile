base.{$SUITE_DOMAIN} {
	# Data links read a table or query as CSV for Sheets without signing in; the token in the
	# address is the key, and Base never reads identity on this path.
	handle /api/feed/* {
		request_header -X-Forwarded-Email
		request_header -X-Forwarded-User
		request_header -X-Forwarded-Preferred-Username
		request_header -X-Dev-User
		import to_app base:3680
	}
	handle {
		import signed_in
		import to_app base:3680
	}
}

