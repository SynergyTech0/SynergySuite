# Routes https://<app>.{$SUITE_DOMAIN} to each app. Every app except auth and the
# public paths below requires a SynergyAuth session, checked by oauth2-proxy.

{
	# Empty in production (certificates from Let's Encrypt). deploy/quickstart.sh sets it to
	# local_certs, so Caddy signs certificates with its own CA for a domain that only resolves
	# to this machine.
	{$CADDY_GLOBAL_OPTIONS}
}

(signed_in) {
	# Never trust identity headers sent by the browser; only the gateway may set them.
	# forward_auth replaces the X-Auth-Request-* headers itself (and drops any the browser
	# sent that the gateway didn't return); these are the other headers apps read identity from.
	# request_header runs after forward_auth, so it must not list the copied headers.
	request_header -X-Forwarded-Email
	request_header -X-Forwarded-User
	request_header -X-Forwarded-Preferred-Username
	request_header -X-Dev-User
	forward_auth oauth2-proxy:4180 {
		uri /oauth2/auth
		copy_headers X-Auth-Request-Email X-Auth-Request-User X-Auth-Request-Preferred-Username
		@signed_out status 401
		handle_response @signed_out {
			redir * https://sso.{$SUITE_DOMAIN}/oauth2/start?rd={scheme}://{host}{uri}
		}
	}
}

# For apps that also serve people without an account (meeting guests): a signed-in user's
# identity is passed on, and anyone else continues with none instead of being sent to sign in.
(maybe_signed_in) {
	request_header -X-Forwarded-Email
	request_header -X-Forwarded-User
	request_header -X-Forwarded-Preferred-Username
	request_header -X-Dev-User
	forward_auth oauth2-proxy:4180 {
		uri /oauth2/auth
		copy_headers X-Auth-Request-Email X-Auth-Request-User X-Auth-Request-Preferred-Username
		@signed_out status 401
		handle_response @signed_out {
			request_header -X-Auth-Request-Email
			request_header -X-Auth-Request-User
			request_header -X-Auth-Request-Preferred-Username
		}
	}
}

# Proves to the app that the request came through this gateway (see @synergy/identity).
(to_app) {
	reverse_proxy {args[0]} {
		header_up X-Proxy-Auth-Secret {$PROXY_SHARED_SECRET}
	}
}

# Phone and desktop calendar and address book apps (CalDAV, CardDAV) sign in with Basic auth
# and an app password, which the app checks with the account service; they can't follow the
# gateway's browser sign-in, so these paths skip it. No identity header from outside gets
# through, and no proxy secret is added: the app trusts only the app password here. Wrong
# passwords are rate limited and locked out by the apps and the account service.
(dav_app) {
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Preferred-Username
	request_header -X-Forwarded-Email
	request_header -X-Forwarded-User
	request_header -X-Forwarded-Preferred-Username
	request_header -X-Dev-User
	request_header -X-Proxy-Auth-Secret
	reverse_proxy {args[0]}
}

auth.{$SUITE_DOMAIN} {
	# App password checks for Calendar and Contacts stay on the compose network.
	handle /api/internal/* {
		respond 404
	}
	handle {
		reverse_proxy auth:3500
	}
}

sso.{$SUITE_DOMAIN} {
	reverse_proxy oauth2-proxy:4180
}

calendar.{$SUITE_DOMAIN} {
	# Machine API, authenticated by bearer token inside the app.
	handle /api/svc/* {
		import to_app calendar:3130
	}
	# CalDAV (see dav_app).
	@dav expression path('/dav', '/dav/*', '/.well-known/caldav') || (path('/') && method('PROPFIND', 'REPORT'))
	handle @dav {
		import dav_app calendar:3130
	}
	handle {
		import signed_in
		import to_app calendar:3130
	}
}

