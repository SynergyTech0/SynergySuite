devices.{$SUITE_DOMAIN} {
	# The osquery agent on each computer has no suite account: it signs in with its enrollment
	# key and node key, checked in the app. The posture feed for Trust stays on the compose network.
	handle /api/osquery/* {
		request_header -X-Forwarded-Email
		request_header -X-Forwarded-User
		request_header -X-Forwarded-Preferred-Username
		request_header -X-Dev-User
		request_header -X-Auth-Request-Email
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Preferred-Username
		import to_app devices:3810
	}
	# iPhones, iPads and Macs under Apple management: their check-ins and commands go to NanoMDM,
	# their certificate requests to the SCEP server. Devices sign these requests themselves; NanoMDM's
	# own API (/v1) is reached only on the compose network.
	handle /mdm/apple/mdm {
		uri strip_prefix /mdm/apple
		reverse_proxy devices-mdm:9000
	}
	handle /scep {
		reverse_proxy devices-scep:8080
	}
	handle /api/svc/* {
		respond 404
	}
	handle {
		import signed_in
		import to_app devices:3810
	}
}

