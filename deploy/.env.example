# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -hex 32
# (deploy/quickstart.sh writes a local deploy/.env from this file with every secret filled in.)

# Every app is served at https://<app>.SUITE_DOMAIN (admin, auth, books, bookings, calendar, chat, commerce, contacts, contracts, status, analytics, livechat, crm, desk, devices, drive, engage, field, forms, groups, hire, law, learn, meet, notes, office, ops, people (redirects to hr), hr, planner, portal, projects, search, sign, sites, sso, todo, trust, vault, sms, shifts).
SUITE_DOMAIN=example.com

POSTGRES_PASSWORD=
# Encrypts TOTP secrets and signing keys at rest in the auth app.
SA_ENCRYPTION_KEY=

# The sign-in gateway's OIDC client. Choose both values (e.g. suite-gateway and openssl rand -hex 32);
# auth-init registers the client in the auth app on start, with redirect URI
# https://sso.SUITE_DOMAIN/oauth2/callback, and keeps it in line with these values.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 32 bytes, e.g. openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=

# Sent by the gateway on every request so apps refuse traffic that bypassed it.
PROXY_SHARED_SECRET=

# Bearer token for machine access to calendar's /api/svc/*: Bookings reads free/busy and adds,
# moves and removes appointments with it, and Groups gives each team its group calendar.
CAL_SVC_TOKEN=

# First admin for the identity provider (default admin@SUITE_DOMAIN), created by auth-init on
# first start. Leave the password empty to have a random one printed once in auth-init's log
# (docker compose -f deploy/compose.yml --env-file deploy/.env logs auth-init).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Caddy. Leave CADDY_GLOBAL_OPTIONS empty for Let's Encrypt certificates; local_certs makes Caddy
# sign them with its own CA instead (for a domain that only resolves on your machine).
# HTTP_PUBLISH/HTTPS_PUBLISH are what Caddy publishes on the host (default 80 and 443; e.g. 127.0.0.1:443).
# Sign-in redirects assume 443, so change the port only if something in front forwards 443 to it.
CADDY_GLOBAL_OPTIONS=
HTTP_PUBLISH=
HTTPS_PUBLISH=

# Optional embeds in published sites: the booking service (default https://bookings.SUITE_DOMAIN)
# and the live-chat widget host (default https://livechat.SUITE_DOMAIN).
SITES_BOOKING_URL=
SITES_LIVECHAT_URL=

# Token for planner's automation API (/api/mind). Leave empty to disable it.
MIND_TOKEN=

# HR: comma-separated HR admins and payroll admins (empty = the HR admins). The old
# People add-on's PEOPLE_ADMIN_EMAILS still works for HR admins. Paid pay runs post to
# Books when BOOKS_SVC_TOKEN is set.
HR_ADMIN_EMAILS=
PAYROLL_ADMIN_EMAILS=
# Encrypts Social Security and bank account numbers for W-2s and direct deposit
# (openssl rand -hex 32; quickstart.sh fills it in). Keep a copy: without it they can't be read.
HR_DATA_KEY=

# Add-ons. Portal: staff allowed in its console
# (empty = any signed-in user). Its invoice and ticket feeds come from Books and Desk
# (BOOKS_SVC_TOKEN, DESK_API_TOKEN); set the four below only to read them from elsewhere.
PORTAL_ALLOWED_EMAILS=
INVOICE_SVC_URL=
INVOICE_SVC_TOKEN=
DESK_SVC_URL=
DESK_SVC_TOKEN=

# Meet and Phone's media server: the livekit service (LiveKit). The key is a short name, the secret
# at least 32 characters (e.g. LIVEKIT_API_KEY=API$(openssl rand -hex 6), LIVEKIT_API_SECRET=
# $(openssl rand -hex 32)); quickstart generates both. Browsers send media straight to it, so open
# 7881/tcp and 7882/udp on the host (LIVEKIT_TCP_PUBLISH/LIVEKIT_UDP_PUBLISH change what's published,
# e.g. 127.0.0.1:7881). LIVEKIT_NODE_IP is the address browsers send media to: empty finds the
# server's public IP over STUN (right for most servers); set it to the public IP if that fails,
# or to 127.0.0.1 (this machine only) or a LAN IP with LIVEKIT_USE_EXTERNAL_IP=false.
# LIVEKIT_UPSTREAM is where the gateway and apps reach a media server you run yourself instead
# (default livekit:7880). LIVEKIT_WEBHOOK_URL is where it reports joins and leaves (default Phone).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=
LIVEKIT_USE_EXTERNAL_IP=
LIVEKIT_TCP_PUBLISH=
LIVEKIT_UDP_PUBLISH=
LIVEKIT_UPSTREAM=
LIVEKIT_WEBHOOK_URL=
# Optional coturn relay for people behind networks that block both 7881/tcp and 7882/udp:
# browsers then relay media through TURN_HOST:3478 (coturn with use-auth-secret=TURN_STATIC_SECRET).
TURN_HOST=
TURN_STATIC_SECRET=

# Phone (Teams Phone equivalent). Uses Meet's LiveKit keys above. Calls between colleagues work
# with just those; real phone numbers also need LiveKit's SIP service and a SIP trunk added in
# Phone admin. To run the SIP service, set COMPOSE_PROFILES=sip and
# LIVEKIT_REDIS_ADDRESS=sip-valkey:6379, and open 5060/udp+tcp (SIP_PUBLISH) and 10000-10099/udp.
# PHONE_ADMIN_EMAILS manage trunks and numbers (default ADMIN_EMAILS). PHONE_COUNTRY_CODE is added to numbers typed without one. PHONE_SVC_TOKEN (openssl rand -hex 32)
# lets Meet call phones into meetings. Voicemail is transcribed with PHONE_AI_SPEECH_MODEL (or
# AI_SPEECH_MODEL) on the AI server above.
PHONE_ADMIN_EMAILS=
PHONE_COUNTRY_CODE=1
PHONE_SIP_HOST=
COMPOSE_PROFILES=
LIVEKIT_REDIS_ADDRESS=
SIP_PUBLISH=
PHONE_SVC_TOKEN=

# Mail (Outlook equivalent) and its mail server, Stalwart.
# MAIL_DOMAIN is the part after @ in users' addresses (default: SUITE_DOMAIN). Sign-in emails must use it.
# MAIL_HOSTNAME is the server's name for MX/SMTP (default: mx.SUITE_DOMAIN).
MAIL_DOMAIN=
MAIL_HOSTNAME=
# openssl rand -base64 32. Encrypts the passwords of outside accounts users connect in Mail.
MAIL_ENCRYPTION_KEY=
# Sign in with Microsoft, for Microsoft 365 (including GoDaddy's) and Outlook.com accounts, which
# no longer accept passwords over IMAP/SMTP. Register an app in Microsoft Entra (see apps/mail/README.md)
# with redirect URI https://mail.SUITE_DOMAIN/api/oauth/microsoft/callback. Tenant: common (any
# organization and Outlook.com) or your directory id. MAIL_PUBLIC_URL overrides https://mail.SUITE_DOMAIN.
MAIL_MICROSOFT_CLIENT_ID=
MAIL_MICROSOFT_CLIENT_SECRET=
MAIL_MICROSOFT_TENANT=
MAIL_PUBLIC_URL=
# Company Microsoft 365 mailboxes without anyone signing in: an app registration in your
# organization with the Microsoft Graph application permissions Mail.ReadWrite and Mail.Send
# (admin consent granted). Everyone who signs in to the suite with an address on MAIL_GRAPH_DOMAINS
# sees that mailbox. MAIL_GRAPH_MAILBOXES gives extra ones: "suite user=mailbox,..." (e.g. a support@ box).
MAIL_GRAPH_TENANT=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=
MAIL_GRAPH_DOMAINS=
MAIL_GRAPH_MAILBOXES=
# openssl rand -hex 24 for both (no quotes or backslashes). The admin password signs in to
# Stalwart's admin UI as "admin" or postmaster@MAIL_DOMAIN; the master password is Mail's service login.
STALWART_ADMIN_PASSWORD=
MAIL_MASTER_PASSWORD=
# Set to false once Stalwart has a real certificate.
MAIL_SUITE_TLS_INSECURE=
# Host ports Stalwart publishes (defaults 25, 465, 993; the admin UI 8080 is bound to 127.0.0.1).
MAIL_SMTP_PUBLISH=
MAIL_SUBMISSION_PUBLISH=
MAIL_IMAPS_PUBLISH=
MAIL_ADMIN_PUBLISH=

# AI: bring your own model. The normal place to set it is the admin console at
# https://auth.SUITE_DOMAIN/admin (Settings > AI model): pick the provider, model and API key there
# (stored encrypted) and every app follows within a minute, no restart. These AI_* settings are the
# fallback, used while nothing is saved there; an app's prefixed ones (e.g. SIGN_AI_MODEL) still
# win for that app. AI stays off until a model is set in one place or the other.
# AI_PROVIDER is openai (default: OpenAI or any OpenAI-compatible server such as
# Ollama, vLLM, LM Studio, OpenRouter, Azure OpenAI or Groq), anthropic, or ollama.
#   OpenAI:  AI_API_KEY=sk-...  AI_MODEL=gpt-4.1-mini  AI_EMBEDDING_MODEL=text-embedding-3-small
#   Local:   AI_PROVIDER=ollama  AI_BASE_URL=http://<host>:11434/v1  AI_MODEL=llama3.1  AI_EMBEDDING_MODEL=nomic-embed-text
# An app can use its own model with prefixed settings, e.g. SIGN_AI_MODEL or MOAT_AI_MODEL.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=
# Speech to text (Stream's automatic captions, Meet transcripts), on an OpenAI-compatible server: whisper-1, or a
# local Whisper server's model such as Systran/faster-whisper-small. Empty = automatic captions off.
AI_SPEECH_MODEL=
# always = transcribe and save every meeting (everyone in it sees "Transcribing"). Needs AI_SPEECH_MODEL.
MEET_TRANSCRIBE=

# Devices (Intune and Defender equivalent). DEVICES_ADMIN_EMAILS (default ADMIN_EMAILS) manage
# every device, policies and alerts; everyone else sees and enrolls their own computers.
# DEVICES_SVC_TOKEN (openssl rand -hex 32) lets Trust read endpoint evidence and lets Auth block
# sign-in from non-compliant devices; empty = off.
# DEVICES_PUBLIC_HOST overrides the name agents connect to (default devices.SUITE_DOMAIN).
# DEVICES_TLS_CA is a PEM certificate installed on agents when your certificates come from a
# private CA (quickstart's local_certs). DEVICES_OSV_URL=off turns the vulnerability lookup off.
DEVICES_ADMIN_EMAILS=
DEVICES_SVC_TOKEN=
DEVICES_PUBLIC_HOST=
DEVICES_TLS_CA=
DEVICES_OSV_URL=
# Apple device management (iPhone, iPad and Mac: lock, erase, settings, apps). Set all three
# (openssl rand -hex 32 each; quickstart does) to turn on the devices-mdm and devices-scep services,
# then upload an Apple push certificate in Devices > Apple devices. DEVICES_ORG_NAME is the name
# devices show for their management profile (default Synergy).
DEVICES_MDM_API_KEY=
DEVICES_MDM_WEBHOOK_KEY=
DEVICES_SCEP_CHALLENGE=
DEVICES_ORG_NAME=
# Android management (lock, erase, settings and Play apps) through Google's Android Management API:
# a Google Cloud service account key (its JSON on one line, or base64 of it). Then connect in
# Devices > Android devices.
DEVICES_ANDROID_SERVICE_ACCOUNT=
# Windows management (settings, MSI apps, restart, reset) is built in and on by default; PCs check in
# at devices-windows.<SUITE_DOMAIN>, which must resolve to this server. Set DEVICES_WINDOWS_MDM=off to
# turn it off, or DEVICES_WINDOWS_MDM_HOST if that host has another name (update the Caddyfile to match).
DEVICES_WINDOWS_MDM=
DEVICES_WINDOWS_MDM_HOST=

# Admin center. ADMIN_EMAILS (comma-separated) may use it; they can make others eDiscovery managers.
# ADMIN_SCIM_TOKEN (a SCIM token from the auth admin console; defaults to DIRECTORY_SCIM_TOKEN)
# lets it list and manage people. COMPLIANCE_TOKEN (openssl rand -hex 32) links every app to it
# for legal holds, retention and eDiscovery search; empty = those are off.
ADMIN_EMAILS=
ADMIN_SCIM_TOKEN=
COMPLIANCE_TOKEN=
# Move from Microsoft 365 (Admin center): encrypts the tenant's client secret and IMAP passwords
# (openssl rand -base64 32); without it no source can be connected. MIGRATION_ALLOW_PRIVATE_HOSTS=1
# lets IMAP imports reach a server on your own network (an old on-premises mail server).
MIGRATION_ENCRYPTION_KEY=
MIGRATION_ALLOW_PRIVATE_HOSTS=

# Search (search.SUITE_DOMAIN, also the box in every app's header) needs nothing set: it asks each
# app as the signed-in person. Its assistant (the Ask tab and the Copilot panel) uses the AI_* model above; SEARCH_AI_*
# give it a model of its own. SEARCH_APP_URLS overrides where it reaches apps, as JSON, e.g.
# {"mail":"http://mail:3200"} (default http://<app>:<port> on the compose network).
SEARCH_AI_PROVIDER=
SEARCH_AI_BASE_URL=
SEARCH_AI_API_KEY=
SEARCH_AI_MODEL=
SEARCH_APP_URLS=
# Draft with Copilot in Mail compose and Calendar event notes uses the AI_* model; these give
# Mail or Calendar a model of their own.
MAIL_AI_PROVIDER=
MAIL_AI_BASE_URL=
MAIL_AI_API_KEY=
MAIL_AI_MODEL=
CALENDAR_AI_PROVIDER=
CALENDAR_AI_BASE_URL=
CALENDAR_AI_API_KEY=
CALENDAR_AI_MODEL=

# Insights (Power BI equivalent; the designer is Metabase at insights.SUITE_DOMAIN/studio).
# INSIGHTS_SECRET (openssl rand -hex 32) derives every password and key Insights uses with
# Metabase; keep it once set. INSIGHTS_SOURCES lists the suite databases to report on
# (default books,crm,desk,base,planner,forms,trust), read-only and without secret columns.
# INSIGHTS_ADMIN_EMAILS are Metabase admins (default ADMIN_EMAILS, else SEED_ADMIN_EMAIL);
# INSIGHTS_ANALYST_EMAILS may also write queries ("*" for everyone); others view dashboards.
# INSIGHTS_SYNC_MINUTES (60) re-checks the sources' grants; INSIGHTS_JAVA_OPTS (-Xmx1g) sizes Metabase.
INSIGHTS_SECRET=
INSIGHTS_SOURCES=
INSIGHTS_ADMIN_EMAILS=
INSIGHTS_ANALYST_EMAILS=
INSIGHTS_SYNC_MINUTES=
INSIGHTS_JAVA_OPTS=

# Engage (company home page, feed and communities). ENGAGE_ADMIN_EMAILS run the home page's quick
# links and moderate every community (default: ADMIN_EMAILS). ENGAGE_COMPANY_NAME heads the home
# page. ENGAGE_AI_* give its summaries a model of their own instead of the AI_* one above.
ENGAGE_ADMIN_EMAILS=
ENGAGE_COMPANY_NAME=
ENGAGE_AI_PROVIDER=
ENGAGE_AI_BASE_URL=
ENGAGE_AI_API_KEY=
ENGAGE_AI_MODEL=

# Whiteboard (whiteboard.SUITE_DOMAIN) needs nothing set. Its sticky-note ideas use the AI_* model
# above; WHITEBOARD_AI_* give it a model of its own.
WHITEBOARD_AI_PROVIDER=
WHITEBOARD_AI_BASE_URL=
WHITEBOARD_AI_API_KEY=
WHITEBOARD_AI_MODEL=

# CRM. CRM_API_TOKEN lets web forms create leads (POST /api/intake/lead); openssl rand -hex 32,
# empty = off. Web leads go to CRM_INTAKE_OWNER (default: the first admin). CRM_AI_* give lead
# scoring its own model instead of the suite's AI_* setting.
CRM_API_TOKEN=
CRM_INTAKE_OWNER=
CRM_AI_PROVIDER=
CRM_AI_BASE_URL=
CRM_AI_API_KEY=
CRM_AI_MODEL=

# Projects. PROJECTS_AI_* give plan drafting its own model instead of the suite's AI_* setting.
# Billing goes to Books as draft invoices when BOOKS_SVC_TOKEN (below) is set.
PROJECTS_AI_PROVIDER=
PROJECTS_AI_BASE_URL=
PROJECTS_AI_API_KEY=
PROJECTS_AI_MODEL=

# Field Service. It bills finished jobs into Books (BOOKS_SVC_TOKEN), takes parts from Commerce
# stock (COMMERCE_SVC_TOKEN), turns Desk cases into work orders and notes progress back on them
# (DESK_API_TOKEN) and imports equipment from Ops (OPS_API_TOKEN); each link is off while its
# token is empty. FIELD_PARTS_ACCOUNT (default 5000) is the Books account parts used on jobs are
# costed to. FIELD_AI_* give checklist drafting its own model instead of the suite's AI_* setting.
FIELD_PARTS_ACCOUNT=
FIELD_AI_PROVIDER=
FIELD_AI_BASE_URL=
FIELD_AI_API_KEY=
FIELD_AI_MODEL=

# Contracts. CONTRACTS_ADMIN_EMAILS is the legal team (default ADMIN_EMAILS): they see every contract
# and keep the template and clause library. CONTRACTS_AI_* give contract review its own model.
# A signing service that takes contracts by API (CONTRACTS_SIGN_URL) and reports back to
# http://contracts:3860/api/svc/sign-events uses CONTRACTS_SIGN_TOKEN both ways; without one,
# people send the printed contract from Sign and upload the signed copy.
CONTRACTS_ADMIN_EMAILS=
CONTRACTS_SIGN_URL=
CONTRACTS_SIGN_TOKEN=
CONTRACTS_AI_PROVIDER=
CONTRACTS_AI_BASE_URL=
CONTRACTS_AI_API_KEY=
CONTRACTS_AI_MODEL=

# Status (uptime monitors and the public status page at https://status.SUITE_DOMAIN/status).
# STATUS_ADMIN_EMAILS (default ADMIN_EMAILS) add monitors and post incidents; everyone signed in
# can look. Monitors can't reach private or internal addresses; STATUS_ALLOW_HOSTS (comma-separated
# host names or addresses) allows particular ones. Checks are kept STATUS_RETENTION_DAYS (default
# 90). A provisioning service can read and add monitors at http://status:3880/api/svc/monitors with
# STATUS_API_TOKEN (empty: off).
STATUS_ADMIN_EMAILS=
STATUS_ALLOW_HOSTS=
STATUS_RETENTION_DAYS=
STATUS_API_TOKEN=

# Analytics (website analytics). Anyone signed in can add a site and see every site's numbers;
# ANALYTICS_ADMIN_EMAILS (default ADMIN_EMAILS) can change or delete any site. Events are kept
# forever unless ANALYTICS_RETENTION_DAYS is set.
ANALYTICS_ADMIN_EMAILS=
ANALYTICS_RETENTION_DAYS=

# LiveChat (chat widget for websites). LIVECHAT_ADMIN_EMAILS (default ADMIN_EMAILS) set up widgets;
# anyone signed in can answer chats. Send to Desk uses Desk's intake API with DESK_API_TOKEN.
LIVECHAT_ADMIN_EMAILS=

# Vault (shared team password vault). VAULT_ALLOWED_EMAILS (comma-separated) may open it; with it
# empty, ADMIN_EMAILS may; with both empty, nobody can. VAULT_ACCESS_CONTACT is who people without
# access are told to ask (an email address or a name).
VAULT_ALLOWED_EMAILS=
VAULT_ACCESS_CONTACT=

# SMS (business texting). Texts cost money, so only SMS_ALLOWED_EMAILS (comma-separated) may use it;
# with it empty, ADMIN_EMAILS may; with both empty, nobody can. SMS_PROVIDER is twilio. With
# TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN set, texts go from TWILIO_FROM_NUMBER (or TWILIO_MESSAGING_SERVICE_SID); point the number's
# "A message comes in" webhook at https://sms.SUITE_DOMAIN/api/webhooks/twilio/inbound (HTTP POST).
# SMS_PUBLIC_URL is the address Twilio calls, when it isn't https://sms.SUITE_DOMAIN (it signs the
# exact URL). SMS_DEFAULT_COUNTRY_CODE (default 1) is added to numbers typed without one.
SMS_ALLOWED_EMAILS=
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SMS_PUBLIC_URL=
SMS_DEFAULT_COUNTRY_CODE=1

# Shifts. SHIFTS_ADMIN_EMAILS (default ADMIN_EMAILS) build and publish schedules and keep the roster;
# with neither set, everyone can. Everyone else sees published shifts and claims open ones.
SHIFTS_ADMIN_EMAILS=

# Learn (training). LEARN_AUTHOR_EMAILS write, publish and assign courses (default ADMIN_EMAILS); everyone
# signed in can take published courses. LEARN_PASS_MARK is the quiz pass mark in percent (default 70).
# LEARN_ORG_NAME is printed on certificates.
LEARN_AUTHOR_EMAILS=
LEARN_PASS_MARK=
LEARN_ORG_NAME=

# Hire (recruiting). HIRE_ADMIN_EMAILS are the recruiters (default ADMIN_EMAILS): they run every job and
# the careers page at https://hire.SUITE_DOMAIN/careers; a job's hiring manager sees that job. Hired
# candidates are added to HR through HR's API as the person asking, so only HR admins can add them.
# HIRE_COMPANY_NAME heads the careers page until a recruiter sets it there. HIRE_AI_* give job
# description drafts their own model.
HIRE_ADMIN_EMAILS=
HIRE_COMPANY_NAME=
HIRE_AI_PROVIDER=
HIRE_AI_BASE_URL=
HIRE_AI_API_KEY=
HIRE_AI_MODEL=

# Law add-on. LAW_ADMIN_EMAILS (default ADMIN_EMAILS) see every matter; LAW_TRUST_EMAILS keep the
# trust accounts (default the Law admins, or everyone when neither is set). LAW_COURT_HOLIDAYS adds
# court closures to the federal holidays (comma-separated YYYY-MM-DD). With BOOKS_SVC_TOKEN set
# (LAW_BOOKS_TOKEN overrides it), bills go to Books as draft invoices and trust entries post as
# journal entries to LAW_BOOKS_TRUST_BANK (default 1015) and LAW_BOOKS_TRUST_LIABILITY (default
# 2150), with earned fees moving to LAW_BOOKS_OPERATING (1010) against LAW_BOOKS_RECEIVABLE (1100).
# Add the trust accounts to Books' chart of accounts first. LAW_AI_* give document reading its own model.
LAW_ADMIN_EMAILS=
LAW_TRUST_EMAILS=
LAW_COURT_HOLIDAYS=
LAW_BOOKS_TOKEN=
LAW_BOOKS_TRUST_BANK=
LAW_BOOKS_TRUST_LIABILITY=
LAW_BOOKS_OPERATING=
LAW_BOOKS_RECEIVABLE=
LAW_AI_PROVIDER=
LAW_AI_BASE_URL=
LAW_AI_API_KEY=
LAW_AI_MODEL=

# Desk (help desk). DESK_API_TOKEN guards ticket intake (POST /api/intake) and the Portal's
# ticket feed, and lets Field Service read cases and add notes to them; openssl rand -hex 32, empty = off. Point DESK_IMAP_* at a support mailbox
# to turn incoming mail into tickets, and DESK_SMTP_* at its outgoing server to email replies.
# Optional: DESK_IMAP_PORT (993), DESK_IMAP_FOLDER (INBOX), DESK_IMAP_POLL_SECONDS (120), DESK_SMTP_PORT (587).
DESK_API_TOKEN=
DESK_IMAP_HOST=
DESK_IMAP_USER=
DESK_IMAP_PASSWORD=
DESK_SMTP_HOST=
DESK_SMTP_USER=
DESK_SMTP_PASSWORD=
DESK_SMTP_FROM=

# Ops (manufacturing and assets). OPS_API_TOKEN lets other services add demand by SKU
# (POST /api/svc/demand), read open purchase requests (GET /api/svc/purchase-requests) and lets
# Field Service import assets (GET /api/svc/assets);
# openssl rand -hex 32, empty = both off. With Commerce's COMMERCE_SVC_TOKEN set, Ops keeps
# stock in Commerce (issues, finished goods and parts go there; Commerce posts to Books).
# With BOOKS_SVC_TOKEN below, assets can be sent to Books' fixed-asset register.
# OPS_WIP_ACCOUNT (default 5000) and OPS_MAINTENANCE_ACCOUNT (default 6000) are the Books
# accounts Commerce posts the other side of issues and spare parts to.
OPS_API_TOKEN=
OPS_WIP_ACCOUNT=
OPS_MAINTENANCE_ACCOUNT=

# Bookings emails confirmations and reminders from each booking page's own suite mailbox, through
# Stalwart (MAIL_MASTER_PASSWORD; a mailbox that doesn't exist yet is created, as Mail does).
# To send everything through one outside mailbox instead, set these. Optional: BOOKINGS_SMTP_PORT (587).
BOOKINGS_SMTP_HOST=
BOOKINGS_SMTP_USER=
BOOKINGS_SMTP_PASSWORD=
BOOKINGS_SMTP_FROM=

# Sign (e-signatures add-on). People sign in with their suite account; signers outside the
# organization sign from emailed links. SIGN_ADMIN_EMAILS (comma-separated; default SEED_ADMIN_EMAIL)
# get Sign's admin pages. Signing requests go out from the suite mailbox sign@MAIL_DOMAIN through
# Stalwart (SIGN_MAIL_FROM picks another); SIGN_SMTP_* sends through one outside mailbox instead
# (optional SIGN_SMTP_PORT, default 587). Documents are kept on the sign-files volume; for S3 (or any
# S3-compatible store: SIGN_S3_ENDPOINT) set SIGN_STORAGE_MODE=s3 and SIGN_S3_*. SIGN_AI_* give field detection its
# own model (one that reads images) instead of the suite's AI_* setting.
SIGN_ADMIN_EMAILS=
SIGN_MAIL_FROM=
SIGN_SMTP_HOST=
SIGN_SMTP_USER=
SIGN_SMTP_PASSWORD=
SIGN_SMTP_FROM=
SIGN_STORAGE_MODE=
SIGN_S3_ENDPOINT=
SIGN_S3_REGION=
SIGN_S3_BUCKET=
SIGN_S3_PREFIX=
SIGN_S3_ACCESS_KEY_ID=
SIGN_S3_SECRET_ACCESS_KEY=
SIGN_AI_PROVIDER=
SIGN_AI_BASE_URL=
SIGN_AI_API_KEY=
SIGN_AI_MODEL=

# Campaigns sends from one suite mailbox through Stalwart (MAIL_MASTER_PASSWORD; created if need be)
# and reads its bounces there. Admins set the From address, organization and postal address in
# Campaigns' settings; these are the defaults (From defaults to marketing@ the mail domain).
CAMPAIGNS_FROM_EMAIL=
CAMPAIGNS_FROM_NAME=
CAMPAIGNS_ORG_NAME=
CAMPAIGNS_POSTAL_ADDRESS=
# Emails a minute at most (default 60); match what your mail host allows.
CAMPAIGNS_PER_MINUTE=
# To send through an outside relay (SES, Postmark, Mailgun, your provider) instead, set these.
# Optional: CAMPAIGNS_SMTP_PORT (587). Then point the bounce reader at the mailbox bounces go to.
CAMPAIGNS_SMTP_HOST=
CAMPAIGNS_SMTP_USER=
CAMPAIGNS_SMTP_PASSWORD=
CAMPAIGNS_BOUNCE_IMAP_HOST=
CAMPAIGNS_BOUNCE_IMAP_USER=
CAMPAIGNS_BOUNCE_IMAP_PASSWORD=

# Diagrams (Visio equivalent). DIAGRAMS_MAX_MB caps one diagram's size (default 25) and
# DIAGRAMS_VERSIONS how many earlier versions each keeps (default 25). DIAGRAMS_AI_* give
# "Describe it to AI" its own model instead of the suite's AI_* setting.
DIAGRAMS_MAX_MB=
DIAGRAMS_VERSIONS=
DIAGRAMS_AI_PROVIDER=
DIAGRAMS_AI_BASE_URL=
DIAGRAMS_AI_API_KEY=
DIAGRAMS_AI_MODEL=

# Books (accounting). BOOKS_ENCRYPTION_KEY encrypts stored bank and EFTPS credentials
# (openssl rand -hex 32); without it those features refuse to save secrets.
# BOOKS_COMPANY_NAME names the company created for the first user (default My Company).
# BOOKS_EMAIL_FROM is the sender for invoices and statements (default noreply@SUITE_DOMAIN).
BOOKS_ENCRYPTION_KEY=
BOOKS_COMPANY_NAME=
BOOKS_EMAIL_FROM=
# BOOKS_SVC_TOKEN lets the Portal add-on show clients their invoices, Commerce post sales to Books, HR
# post paid pay runs and Projects and Field Service bill into Books as draft invoices. openssl rand -hex 32; empty = off.
BOOKS_SVC_TOKEN=

# Flow (Power Automate equivalent; the engine is Activepieces Community Edition). Required for
# Flow; deploy/quickstart.sh fills them in. FLOW_SECRET (openssl rand -hex 32) signs people in to
# the engine and makes the keys Synergy steps use: changing it revokes every key and locks people
# out of their engine accounts. FLOW_DB_PASSWORD (openssl rand -hex 24) is the engine's own
# database. FLOW_ENCRYPTION_KEY must be exactly 32 hex characters (openssl rand -hex 16).
# FLOW_JWT_SECRET: openssl rand -hex 32. FLOW_POLL_MINUTES: how often polling triggers such as
# "New form response" check (default 5). FLOW_ENGINE_VERSION pins the engine image.
FLOW_SECRET=
FLOW_DB_PASSWORD=
FLOW_ENCRYPTION_KEY=
FLOW_JWT_SECRET=
FLOW_POLL_MINUTES=
FLOW_ENGINE_VERSION=

# Contacts' organization directory. Create a token under "SCIM provisioning tokens" in the auth
# admin console and paste it here to list every suite account; empty lists the people who have opened Contacts.
DIRECTORY_SCIM_TOKEN=

# Drive (files). Empty means no limit. DRIVE_QUOTA_MB is storage per person, every version
# counted (shared libraries are not limited); DRIVE_MAX_FILE_MB caps one upload. Deleted items
# stay in the recycle bin DRIVE_TRASH_DAYS (default 93); each file keeps its newest
# DRIVE_VERSIONS versions (default 100).
DRIVE_QUOTA_MB=
DRIVE_MAX_FILE_MB=
DRIVE_TRASH_DAYS=
DRIVE_VERSIONS=
# DRIVE_SVC_TOKEN (openssl rand -hex 32) lets Sites give each site a document library in Drive
# and keep its people in step with the site's; empty = sites have no document libraries.
DRIVE_SVC_TOKEN=

# Stream (videos). STREAM_MAX_UPLOAD_MB caps one upload (default 10240, 10 GB). STREAM_JOBS is how
# many videos ffmpeg works on at once (default 1); raise it on a machine with cores to spare.
STREAM_MAX_UPLOAD_MB=
STREAM_JOBS=

# Trust (compliance readiness). TRUST_COMPANY_NAME names the organisation created for the
# first user who opens Trust (default My Company); everyone after that is added by email.
TRUST_COMPANY_NAME=

# Demo mode, for a public demo instance. Off unless DEMO_MODE=1. When on:
#   - the `demo` service seeds a fictional company (sample calendar, chat, notes, planner and mail)
#     and resets calendar, chat, notes, planner and the demo mailboxes to it every DEMO_RESET_MINUTES
#     (default 60). It wipes what everyone added in those apps, so use it only on a demo instance.
#   - the sign-in page shows the shared login DEMO_EMAIL / DEMO_PASSWORD (defaults demo@MAIL_DOMAIN
#     and SynergyDemo1); that account can't change its password or set up MFA or passkeys.
#   - no email leaves the server: Stalwart refuses relaying, Mail sends only to MAIL_DOMAIN and
#     can't connect outside accounts, and auth and meet send no email.
DEMO_MODE=
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_RESET_MINUTES=

# Commerce (inventory, purchasing, point of sale and the online store at commerce.<domain>/store).
# Sales, refunds, deliveries and stock changes post to Books with BOOKS_SVC_TOKEN (set above);
# BOOKS_INTERNAL_URL only needs setting when Books runs elsewhere. Online card payment needs a
# payment provider: Commerce POSTs to COMMERCE_CHECKOUT_URL with COMMERCE_CHECKOUT_TOKEN and the
# provider confirms payment back at /api/store/payments with the same token (see
# apps/commerce/README.md). Empty = shoppers pay at pickup or on delivery.
BOOKS_INTERNAL_URL=
COMMERCE_CHECKOUT_URL=
COMMERCE_CHECKOUT_TOKEN=
# COMMERCE_SVC_TOKEN lets other suite apps (Operations, Field Service) read items and stock and record parts used
# and products made (/api/svc/*). openssl rand -hex 32; empty = off.
COMMERCE_SVC_TOKEN=

# Groups (Microsoft 365 Groups and Teams). GROUPS_ADMIN_EMAILS (comma separated) may manage and
# restore every group. GROUPS_CREATE=admins lets only them create groups; empty = everyone can.
# Group addresses use MAIL_DOMAIN. Team calendars need CAL_SVC_TOKEN (above).
GROUPS_ADMIN_EMAILS=
GROUPS_CREATE=
