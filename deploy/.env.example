# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -hex 32
# (deploy/quickstart.sh writes a local deploy/.env from this file with every secret filled in.)

# Every app is served at https://<app>.SUITE_DOMAIN (admin, auth, books, calendar, chat, contacts, crm, desk, drive, engage, forms, meet, notes, office, people (redirects to hr), hr, planner, portal, search, sites, sso, todo, trust).
SUITE_DOMAIN=example.com

POSTGRES_PASSWORD=
# Encrypts TOTP secrets and signing keys at rest in the auth app.
SA_ENCRYPTION_KEY=

# The sign-in gateway's OIDC client. Choose both values (e.g. suite-gateway and openssl rand -hex 32);
# auth-init registers the client in the auth app on start, with redirect URI
# https://sso.SUITE_DOMAIN/oauth2/callback, and keeps it in line with these values.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 32 bytes, e.g. openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=

# Sent by the gateway on every request so apps refuse traffic that bypassed it.
PROXY_SHARED_SECRET=

# Bearer token for machine access to calendar's /api/svc/* (free/busy, booking).
CAL_SVC_TOKEN=

# First admin for the identity provider (default admin@SUITE_DOMAIN), created by auth-init on
# first start. Leave the password empty to have a random one printed once in auth-init's log
# (docker compose -f deploy/compose.yml --env-file deploy/.env logs auth-init).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Caddy. Leave CADDY_GLOBAL_OPTIONS empty for Let's Encrypt certificates; local_certs makes Caddy
# sign them with its own CA instead (for a domain that only resolves on your machine).
# HTTP_PUBLISH/HTTPS_PUBLISH are what Caddy publishes on the host (default 80 and 443; e.g. 127.0.0.1:443).
# Sign-in redirects assume 443, so change the port only if something in front forwards 443 to it.
CADDY_GLOBAL_OPTIONS=
HTTP_PUBLISH=
HTTPS_PUBLISH=

# Optional embeds in published sites: a booking service and a live-chat widget host.
# Leave empty to hide those blocks.
SITES_BOOKING_URL=
SITES_LIVECHAT_URL=

# Token for planner's automation API (/api/mind). Leave empty to disable it.
MIND_TOKEN=

# HR: comma-separated HR admins (PEOPLE_ADMIN_EMAILS still works) and payroll admins
# (empty = the HR admins). Paid pay runs post to Books when BOOKS_SVC_TOKEN is set.
HR_ADMIN_EMAILS=
PAYROLL_ADMIN_EMAILS=

# Add-ons. Portal: staff allowed in its console
# (empty = any signed-in user). Its invoice and ticket feeds come from Books and Desk
# (BOOKS_SVC_TOKEN, DESK_API_TOKEN); set the four below only to read them from elsewhere.
PEOPLE_ADMIN_EMAILS=
PORTAL_ALLOWED_EMAILS=
INVOICE_SVC_URL=
INVOICE_SVC_TOKEN=
DESK_SVC_URL=
DESK_SVC_TOKEN=

# Meet. The LiveKit media server runs from apps/meet/deploy; use the same key and secret here.
# LIVEKIT_UPSTREAM is where the gateway reaches LiveKit's /rtc and /twirp (default livekit:7880).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_UPSTREAM=
# Optional coturn relay for callers behind strict NAT.
TURN_HOST=
TURN_STATIC_SECRET=

# Mail (Outlook equivalent) and its mail server, Stalwart.
# MAIL_DOMAIN is the part after @ in users' addresses (default: SUITE_DOMAIN). Sign-in emails must use it.
# MAIL_HOSTNAME is the server's name for MX/SMTP (default: mx.SUITE_DOMAIN).
MAIL_DOMAIN=
MAIL_HOSTNAME=
# openssl rand -base64 32. Encrypts the passwords of outside accounts users connect in Mail.
MAIL_ENCRYPTION_KEY=
# openssl rand -hex 24 for both (no quotes or backslashes). The admin password signs in to
# Stalwart's admin UI as "admin" or postmaster@MAIL_DOMAIN; the master password is Mail's service login.
STALWART_ADMIN_PASSWORD=
MAIL_MASTER_PASSWORD=
# Set to false once Stalwart has a real certificate.
MAIL_SUITE_TLS_INSECURE=
# Host ports Stalwart publishes (defaults 25, 465, 993; the admin UI 8080 is bound to 127.0.0.1).
MAIL_SMTP_PUBLISH=
MAIL_SUBMISSION_PUBLISH=
MAIL_IMAPS_PUBLISH=
MAIL_ADMIN_PUBLISH=

# AI: bring your own model. Every AI feature in the suite uses these, and AI stays off until
# AI_MODEL is set. AI_PROVIDER is openai (default: OpenAI or any OpenAI-compatible server such as
# Ollama, vLLM, LM Studio, OpenRouter, Azure OpenAI or Groq), anthropic, or ollama.
#   OpenAI:  AI_API_KEY=sk-...  AI_MODEL=gpt-4.1-mini  AI_EMBEDDING_MODEL=text-embedding-3-small
#   Local:   AI_PROVIDER=ollama  AI_BASE_URL=http://<host>:11434/v1  AI_MODEL=llama3.1  AI_EMBEDDING_MODEL=nomic-embed-text
# An app can use its own model with prefixed settings, e.g. SIGN_AI_MODEL or MOAT_AI_MODEL.
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=

# Admin center. ADMIN_EMAILS (comma-separated) may use it; they can make others eDiscovery managers.
# ADMIN_SCIM_TOKEN (a SCIM token from the auth admin console; defaults to DIRECTORY_SCIM_TOKEN)
# lets it list and manage people. COMPLIANCE_TOKEN (openssl rand -hex 32) links every app to it
# for legal holds, retention and eDiscovery search; empty = those are off.
ADMIN_EMAILS=
ADMIN_SCIM_TOKEN=
COMPLIANCE_TOKEN=

# Search (search.SUITE_DOMAIN, also the box in every app's header) needs nothing set: it asks each
# app as the signed-in person. Its assistant (the Ask tab) uses the AI_* model above; SEARCH_AI_*
# give it a model of its own. SEARCH_APP_URLS overrides where it reaches apps, as JSON, e.g.
# {"mail":"http://mail:3200"} (default http://<app>:<port> on the compose network).
SEARCH_AI_PROVIDER=
SEARCH_AI_BASE_URL=
SEARCH_AI_API_KEY=
SEARCH_AI_MODEL=
SEARCH_APP_URLS=

# Insights (Power BI equivalent; the designer is Metabase at insights.SUITE_DOMAIN/studio).
# INSIGHTS_SECRET (openssl rand -hex 32) derives every password and key Insights uses with
# Metabase; keep it once set. INSIGHTS_SOURCES lists the suite databases to report on
# (default books,crm,desk,base,planner,forms,trust), read-only and without secret columns.
# INSIGHTS_ADMIN_EMAILS are Metabase admins (default ADMIN_EMAILS, else SEED_ADMIN_EMAIL);
# INSIGHTS_ANALYST_EMAILS may also write queries ("*" for everyone); others view dashboards.
# INSIGHTS_SYNC_MINUTES (60) re-checks the sources' grants; INSIGHTS_JAVA_OPTS (-Xmx1g) sizes Metabase.
INSIGHTS_SECRET=
INSIGHTS_SOURCES=
INSIGHTS_ADMIN_EMAILS=
INSIGHTS_ANALYST_EMAILS=
INSIGHTS_SYNC_MINUTES=
INSIGHTS_JAVA_OPTS=

# Engage (company home page, feed and communities). ENGAGE_ADMIN_EMAILS run the home page's quick
# links and moderate every community (default: ADMIN_EMAILS). ENGAGE_COMPANY_NAME heads the home
# page. ENGAGE_AI_* give its summaries a model of their own instead of the AI_* one above.
ENGAGE_ADMIN_EMAILS=
ENGAGE_COMPANY_NAME=
ENGAGE_AI_PROVIDER=
ENGAGE_AI_BASE_URL=
ENGAGE_AI_API_KEY=
ENGAGE_AI_MODEL=

# CRM. CRM_API_TOKEN lets web forms create leads (POST /api/intake/lead); openssl rand -hex 32,
# empty = off. Web leads go to CRM_INTAKE_OWNER (default: the first admin). CRM_AI_* give lead
# scoring its own model instead of the suite's AI_* setting.
CRM_API_TOKEN=
CRM_INTAKE_OWNER=
CRM_AI_PROVIDER=
CRM_AI_BASE_URL=
CRM_AI_API_KEY=
CRM_AI_MODEL=

# Desk (help desk). DESK_API_TOKEN guards ticket intake (POST /api/intake) and the Portal's
# ticket feed; openssl rand -hex 32, empty = both off. Point DESK_IMAP_* at a support mailbox
# to turn incoming mail into tickets, and DESK_SMTP_* at its outgoing server to email replies.
# Optional: DESK_IMAP_PORT (993), DESK_IMAP_FOLDER (INBOX), DESK_IMAP_POLL_SECONDS (120), DESK_SMTP_PORT (587).
DESK_API_TOKEN=
DESK_IMAP_HOST=
DESK_IMAP_USER=
DESK_IMAP_PASSWORD=
DESK_SMTP_HOST=
DESK_SMTP_USER=
DESK_SMTP_PASSWORD=
DESK_SMTP_FROM=

# Books (accounting). BOOKS_ENCRYPTION_KEY encrypts stored bank and EFTPS credentials
# (openssl rand -hex 32); without it those features refuse to save secrets.
# BOOKS_COMPANY_NAME names the company created for the first user (default My Company).
# BOOKS_EMAIL_FROM is the sender for invoices and statements (default noreply@SUITE_DOMAIN).
BOOKS_ENCRYPTION_KEY=
BOOKS_COMPANY_NAME=
BOOKS_EMAIL_FROM=
# BOOKS_SVC_TOKEN lets the Portal add-on show clients their invoices and HR post paid pay runs. openssl rand -hex 32; empty = off.
BOOKS_SVC_TOKEN=

# Contacts' organization directory. Create a token under "SCIM provisioning tokens" in the auth
# admin console and paste it here to list every suite account; empty lists the people who have opened Contacts.
DIRECTORY_SCIM_TOKEN=

# Drive (files). Empty means no limit. DRIVE_QUOTA_MB is storage per person, every version
# counted (shared libraries are not limited); DRIVE_MAX_FILE_MB caps one upload. Deleted items
# stay in the recycle bin DRIVE_TRASH_DAYS (default 93); each file keeps its newest
# DRIVE_VERSIONS versions (default 100).
DRIVE_QUOTA_MB=
DRIVE_MAX_FILE_MB=
DRIVE_TRASH_DAYS=
DRIVE_VERSIONS=

# Trust (compliance readiness). TRUST_COMPANY_NAME names the organisation created for the
# first user who opens Trust (default My Company); everyone after that is added by email.
TRUST_COMPANY_NAME=

# Demo mode, for a public demo instance. Off unless DEMO_MODE=1. When on:
#   - the `demo` service seeds a fictional company (sample calendar, chat, notes, planner and mail)
#     and resets calendar, chat, notes, planner and the demo mailboxes to it every DEMO_RESET_MINUTES
#     (default 60). It wipes what everyone added in those apps, so use it only on a demo instance.
#   - the sign-in page shows the shared login DEMO_EMAIL / DEMO_PASSWORD (defaults demo@MAIL_DOMAIN
#     and SynergyDemo1); that account can't change its password or set up MFA or passkeys.
#   - no email leaves the server: Stalwart refuses relaying, Mail sends only to MAIL_DOMAIN and
#     can't connect outside accounts, and auth and meet send no email.
DEMO_MODE=
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_RESET_MINUTES=
