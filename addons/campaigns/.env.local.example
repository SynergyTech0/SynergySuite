# Copy to .env.local and fill in.

# --- Storage: SynergyDB (Postgres wire) ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5499/synergydb

# --- Public base URL used in tracking pixels / click links / unsubscribe ---
# Must be reachable by recipients' mail clients. For local testing this is fine;
# for a real send point it at your public host (e.g. https://campaigns.example.com).
PUBLIC_BASE_URL=http://localhost:3400

# --- SMTP (consumed by the Python mailer delivery worker) ---
MAILER_SMTP_HOST=smtp.gmail.com
MAILER_SMTP_PORT=587
MAILER_SMTP_USERNAME=you@yourdomain.com
MAILER_SMTP_SECURITY=starttls
MAILER_SMTP_PASSWORD=your-app-password

# Sender identity + CAN-SPAM required fields
MAILER_FROM_NAME=Shane Sipe
MAILER_FROM_EMAIL=you@example.com
MAILER_REPLY_TO=you@example.com
MAILER_ORG_NAME=SynergyTech
MAILER_POSTAL_ADDRESS=123 Example St, Suite 100, YourCity, ST 00000

# Path to the Python mailer built earlier (delivery worker)
MAILER_DIR=/path/to/email-mailer
PYTHON_BIN=python

# Throttle (emails per minute)
MAILER_PER_MINUTE=30

# Secret that authorizes the /api/cron scheduler tick
CRON_SECRET=change-me
