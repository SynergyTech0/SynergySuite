# SynergySign — environment
# Copy to `.env` and fill in. Only the "REQUIRED" block is needed to boot.

# ---------- REQUIRED ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synergysign"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-openssl-rand-base64-32"

# ---------- DOCUMENT INTELLIGENCE (the AI) ----------
# Without this, AI field detection/analysis returns 503 and fields must be placed by hand.
# It never falls back to fabricated fields.
# Bring your own model: openai (any OpenAI-compatible server: OpenAI, Ollama, vLLM, LM Studio,
# OpenRouter, Azure, Groq), anthropic, or ollama. Field placement reads page images, so use a
# model that accepts images and tool calls. SIGN_AI_* overrides these for sign only.
AI_PROVIDER=""
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# ---------- STORAGE ----------
# 'local' | 's3' | 'hybrid'. LOCAL_STORAGE_PATH is where PDFs actually live — the uploader AND the
# finalizer both resolve through lib/storage, so these must agree. (A mismatch here used to make
# documents silently "complete" with no signed PDF.)
STORAGE_MODE="local"
LOCAL_STORAGE_PATH="./uploads"
ENABLE_S3_BACKUP="false"

# S3 (only when STORAGE_MODE is s3/hybrid)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""

# ---------- BILLING (Stripe) ----------
# lib/stripe.ts THROWS at import if STRIPE_SECRET_KEY is absent, so a placeholder is required even
# for local dev / builds.
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_BASIC_MONTHLY_PRICE_ID=""
STRIPE_BASIC_QUARTERLY_PRICE_ID=""
STRIPE_BASIC_ANNUAL_PRICE_ID=""
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_QUARTERLY_PRICE_ID=""
STRIPE_PRO_ANNUAL_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# ---------- EMAIL ----------
EMAIL_USER=""
EMAIL_PASS=""
REPLY_EMAIL="no-reply@synergysign.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_USER_EMAIL=""

# ---------- MISC ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
CRON_SECRET=""

# ---------- LEGACY / UNUSED ----------
# The external GPU inference server is not part of this repo. AI now runs through lib/ai.
INFERENCE_API_URL=""
INFERENCE_HMAC_SECRET=""
