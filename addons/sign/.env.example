# Sign: settings for running it outside Docker (in the suite, deploy/compose.yml sets these).
# Copy to `.env` and fill in.

# ---------- REQUIRED ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sign"
# Where people reach Sign (links in emails point here).
SIGN_PUBLIC_URL="http://localhost:3300"

# ---------- SIGN-IN (the suite gateway) ----------
# Sign trusts the gateway's x-auth-request-* headers when they carry this shared secret.
PROXY_SHARED_SECRET=""
# The suite's sign-in (https://sso.<SUITE_DOMAIN> when SUITE_DOMAIN is set).
SUITE_DOMAIN=""
SSO_URL=""
# Comma-separated suite accounts that get Sign's admin pages.
SIGN_ADMIN_EMAILS=""
# Signs the short-lived links a signer's PDF viewer loads the document through.
SIGN_LINK_SECRET="change-me-openssl-rand-hex-32"

# ---------- DOCUMENT INTELLIGENCE (the AI) ----------
# Without this, AI field detection/analysis returns 503 and fields must be placed by hand.
# It never falls back to fabricated fields.
# Bring your own model through @synergy/ai: openai (any OpenAI-compatible server), anthropic, or
# ollama. Field placement reads page images, so use a model that accepts images and tool calls.
# SIGN_AI_* overrides AI_* for Sign only.
AI_PROVIDER=""
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# ---------- STORAGE ----------
# 'local' | 's3' | 'hybrid'. LOCAL_STORAGE_PATH is where PDFs live.
STORAGE_MODE="local"
LOCAL_STORAGE_PATH="./uploads"
ENABLE_S3_BACKUP="false"

# S3 (only when STORAGE_MODE is s3/hybrid); AWS_ENDPOINT_URL for an S3-compatible store.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=""
AWS_ENDPOINT_URL=""

# ---------- EMAIL ----------
# One outside mailbox (port 465 or 587)...
SIGN_SMTP_HOST=""
SIGN_SMTP_PORT=""
SIGN_SMTP_USER=""
SIGN_SMTP_PASSWORD=""
SIGN_SMTP_FROM=""
# ...or the suite's Stalwart (MAIL_SMTP_HOST, MAIL_MASTER_USER, MAIL_MASTER_PASSWORD, MAIL_DOMAIN).
# With neither, messages are written to SIGN_DEV_MAIL_DIR (default ./dev-mail) instead of sent.
SIGN_DEV_MAIL_DIR=""

# ---------- MISC ----------
# Lets a scheduler call /api/cron/* (affiliate earnings); those routes refuse when it is unset.
CRON_SECRET=""
# The hosted product's billing pages stay hidden unless this is 1 (they need STRIPE_*).
SIGN_BILLING=""
