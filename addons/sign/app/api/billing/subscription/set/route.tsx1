/**
 * Secure endpoint to create a Stripe Checkout Session for subscription upgrades
 * 
 * Security measures:
 * - User authentication required
 * - No card data handled by our server (PCI compliance)
 * - Uses Stripe Checkout for secure payment processing
 * - Creates or retrieves Stripe customer
 * - Returns checkout session URL for redirect
 */

import { NextResponse } from "next/server";
import { getServerSession } from "next-auth";
import { authOptions } from "@/lib/auth";
import { prisma } from "@/lib/prisma";
import { createCheckoutSession, createOrGetCustomer, getPriceId, BillingCycle, SubscriptionTier, stripe } from "@/lib/stripe";

export async function POST(req: Request) {
  try {
    // 1. Authenticate the user
    const session = await getServerSession(authOptions);
    if (!session?.user?.id) {
      return NextResponse.json(
        { error: "Unauthorized" },
        { status: 401 }
      );
    }

    const { plan, billingCycle } = await req.json();

    // 2. Validate plan parameter
    if (!plan || (plan !== "basic" && plan !== "pro")) {
      return NextResponse.json(
        { error: "Invalid plan. Must be 'basic' or 'pro'" },
        { status: 400 }
      );
    }

    // 2a. Validate billing cycle parameter
    if (billingCycle && !["monthly", "quarterly", "annual"].includes(billingCycle)) {
      return NextResponse.json(
        { error: "Invalid billing cycle. Must be 'monthly', 'quarterly', or 'annual'" },
        { status: 400 }
      );
    }

    // 3. Get user from database with subscription
    const user = await prisma.user.findUnique({
      where: { id: session.user.id },
      include: {
        subscription: true,
      },
    });

    if (!user || !user.email) {
      return NextResponse.json(
        { error: "User not found" },
        { status: 404 }
      );
    }

    // 4. Create or get Stripe customer
    let customerId = user.stripeAccountId;

    if (!customerId) {
      const customer = await createOrGetCustomer(
        user.email,
        user.name || user.email,
        user.id
      );
      customerId = customer.id;

      // Update user with Stripe customer ID
      await prisma.user.update({
        where: { id: user.id },
        data: { stripeAccountId: customerId },
      });
    }

    // 5. Get the correct price ID based on tier and billing cycle
    const newTier = plan.toUpperCase() as SubscriptionTier;
    const priceId = getPriceId(newTier, billingCycle as BillingCycle);

    // 6. Check if user has existing active subscription
    const existingSubscription = user.subscription;
    const hasActiveSubscription = existingSubscription?.status === "ACTIVE" && existingSubscription?.stripeSubscriptionId;

    if (hasActiveSubscription) {
      // Determine tier hierarchy: FREE < BASIC < PRO < ENTERPRISE
      const tierHierarchy: Record<string, number> = {
        "FREE": 0,
        "BASIC": 1,
        "PRO": 2,
        "ENTERPRISE": 3,
      };

      const currentTierLevel = tierHierarchy[existingSubscription!.tier] || 0;
      const newTierLevel = tierHierarchy[newTier] || 0;
      const isUpgrade = newTierLevel > currentTierLevel;
      const isDowngrade = newTierLevel < currentTierLevel;

      // Handle upgrade or downgrade via subscription update
      if (isUpgrade) {
        // UPGRADE: Apply immediately with proration
        const updatedSubscription = await stripe.subscriptions.update(
          existingSubscription!.stripeSubscriptionId!,
          {
            items: [
              {
                id: (await stripe.subscriptions.retrieve(existingSubscription!.stripeSubscriptionId!)).items.data[0].id,
                price: priceId,
              },
            ],
            proration_behavior: 'create_prorations', // Prorate the difference
          }
        );

        // Update database immediately
        await prisma.subscription.update({
          where: { userId: user.id },
          data: {
            tier: newTier,
            stripePriceId: priceId,
            pendingTier: null, // Clear any pending tier
            cancelAtPeriodEnd: false, // Clear cancellation if set
            currentPeriodEnd: new Date(updatedSubscription.current_period_end * 1000),
          },
        });

        return NextResponse.json({
          success: true,
          upgraded: true,
          message: "Your subscription has been upgraded immediately!",
          redirectUrl: `${process.env.NEXT_PUBLIC_SITE_URL || "http://localhost:3000"}/dashboard`,
        });
      } else if (isDowngrade) {
        // DOWNGRADE: Schedule for end of current period
        const updatedSubscription = await stripe.subscriptions.update(
          existingSubscription!.stripeSubscriptionId!,
          {
            items: [
              {
                id: (await stripe.subscriptions.retrieve(existingSubscription!.stripeSubscriptionId!)).items.data[0].id,
                price: priceId,
              },
            ],
            proration_behavior: 'none', // No proration for downgrades
            billing_cycle_anchor: 'unchanged', // Keep current billing cycle
          }
        );

        // Update database with pending tier
        await prisma.subscription.update({
          where: { userId: user.id },
          data: {
            pendingTier: newTier,
            stripePriceId: priceId, // Update price for next period
            cancelAtPeriodEnd: false, // Clear cancellation if set
          },
        });

        return NextResponse.json({
          success: true,
          downgraded: true,
          message: "Your subscription will be downgraded at the end of your current billing period.",
          currentPeriodEnd: existingSubscription!.currentPeriodEnd,
          redirectUrl: `${process.env.NEXT_PUBLIC_SITE_URL || "http://localhost:3000"}/dashboard`,
        });
      } else {
        // Same tier - just update billing cycle if different
        const updatedSubscription = await stripe.subscriptions.update(
          existingSubscription!.stripeSubscriptionId!,
          {
            items: [
              {
                id: (await stripe.subscriptions.retrieve(existingSubscription!.stripeSubscriptionId!)).items.data[0].id,
                price: priceId,
              },
            ],
            proration_behavior: 'create_prorations',
          }
        );

        await prisma.subscription.update({
          where: { userId: user.id },
          data: {
            stripePriceId: priceId,
            currentPeriodEnd: new Date(updatedSubscription.current_period_end * 1000),
          },
        });

        return NextResponse.json({
          success: true,
          message: "Your billing cycle has been updated!",
          redirectUrl: `${process.env.NEXT_PUBLIC_SITE_URL || "http://localhost:3000"}/dashboard`,
        });
      }
    }

    // 7. No existing subscription - Create new Stripe Checkout Session
    const baseUrl = process.env.NEXT_PUBLIC_SITE_URL || "http://localhost:3000";
    const checkoutSession = await createCheckoutSession(
      customerId,
      priceId,
      user.id,
      `${baseUrl}/dashboard/billing/upgrade/success?session_id={CHECKOUT_SESSION_ID}`,
      `${baseUrl}/dashboard/billing/upgrade/cancel`
    );

    if (!checkoutSession) {
      throw new Error("Failed to create Stripe Checkout session");
    }

    // 8. Return the checkout URL to frontend
    return NextResponse.json({
      success: true,
      checkoutUrl: checkoutSession.url,
      sessionId: checkoutSession.id,
    });

  } catch (error) {
    console.error("Error creating checkout session:", error);
    return NextResponse.json(
      { error: "Failed to create checkout session" },
      { status: 500 }
    );
  }
}