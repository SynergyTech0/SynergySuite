{
  "name": "@synergy/shell",
  "version": "0.1.0",
  "private": true,
  "description": "<synergy-app-bar>: the suite header with app launcher, usable from any frontend.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@synergy/config": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --format=esm --minify --target=es2020 --outfile=dist/app-bar.js",
    "test": "node --test test/*.test.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app-bar.js": "./dist/app-bar.js"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1"
  }
}
